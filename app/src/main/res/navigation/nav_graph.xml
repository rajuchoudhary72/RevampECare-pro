<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.app.ecarepro.ui.splash.SplashFragment"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashFragment_to_schoolCodeFragment"
            app:destination="@id/schoolCodeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.app.ecarepro.ui.onboarding.OnboardingFragment"
        android:label="OnboardingFragment">

        <action
            android:id="@+id/action_onboardingFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_onboardingFragment_to_schoolCodeFragment"
            app:destination="@id/schoolCodeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.app.ecarepro.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/schoolCodeFragment"
        android:name="com.app.ecarepro.ui.institutioncode.InstitutionCodeFragment"
        android:label="SchoolCodeFragment"
        tools:layout="@layout/fragment_institution_code">

        <action
            android:id="@+id/action_schoolCodeFragment_to_searchInstitutionFragment"
            app:destination="@id/searchInstitutionFragment" />

        <action
            android:id="@+id/action_schoolCodeFragment_to_signInFragment"
            app:destination="@id/signInFragment" />

    </fragment>

    <fragment
        android:id="@+id/searchInstitutionFragment"
        android:name="com.app.ecarepro.ui.searchinstitution.SearchInstitutionFragment"
        android:label="SearchInstitutionFragment"
        tools:layout="@layout/fragment_search_institution" />

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.app.ecarepro.ui.signin.SignInFragment"
        android:label="SignInFragment"
        tools:layout="@layout/fragment_sign_in">
        <action
            android:id="@+id/action_signInFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />


        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/schoolCodeFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.app.ecarepro.ui.forgotpassword.ForgotPasswordFragment"
        android:label="ForgotPasswordFragment"
        tools:layout="@layout/fragment_forgot_password" />

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.app.ecarepro.ui.help.HelpFragment"
        android:label="HelpFragment"
        tools:layout="@layout/fragment_help" />

    <fragment
        android:id="@+id/webViewFragment"
        android:name="com.app.ecarepro.ui.webview.WebViewFragment"
        android:label="WebViewFragment"
        tools:layout="@layout/fragment_web_view" />

    <fragment
        android:id="@+id/widgetsFragment"
        android:name="com.app.ecarepro.ui.widget.WidgetsFragment"
        android:label="WidgetsFragment"
        tools:layout="@layout/fragment_widgets" />

    <fragment
        android:id="@+id/favouritesFragment"
        android:name="com.app.ecarepro.ui.favourites.FavouritesFragment"
        android:label="FavouritesFragment"
        tools:layout="@layout/fragment_favourites" />

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.app.ecarepro.ui.notification.NotificationFragment"
        android:label="NotificationFragment"
        tools:layout="@layout/fragment_notification" />

    <fragment
        android:id="@+id/messageFragment"
        android:name="com.app.ecarepro.ui.message.MessageFragment"
        android:label="MessageFragment"
        tools:layout="@layout/fragment_message" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.app.ecarepro.ui.dashbord.DashboardFragment"
        android:label="DashboardFragment" />
    <fragment
        android:id="@+id/noticeListFragment"
        android:name="com.app.ecarepro.ui.notice.NoticeListFragment"
        android:label="NoticeListFragment" />

</navigation>