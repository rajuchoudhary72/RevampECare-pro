<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.question_bank.add_question_bank.AddQuestionBankFragment">


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            app:layout_collapseMode="pin"
            app:titleCentered="true"
            android:elevation="8dp"
            app:title="Add Question Bank"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            android:theme="@style/MyThemeOverlay_Toolbar"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white" />


        <LinearLayout
            android:id="@+id/LL_add_infraction"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/_15sdp">


            <TextView
                android:id="@+id/tv_select_que_type"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:gravity="center_vertical"
                android:padding="13dp"
                android:layout_marginVertical="5dp"
                android:text="@string/question_type"
                android:visibility="visible"
                app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


            <TextView
                android:id="@+id/tv_select_class"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:gravity="center_vertical"
                android:padding="13dp"
                android:text="@string/select_class"
                android:visibility="visible"
                app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

            <TextView
                android:id="@+id/tv_select_sub"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:gravity="center_vertical"
                android:padding="13dp"
                android:text="@string/select_subject"
                android:visibility="visible"
                app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

            <TextView
                android:id="@+id/tv_select_chapter"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:gravity="center_vertical"
                android:padding="13dp"
                android:text="@string/select_chapter"
                android:visibility="visible"
                app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


            <EditText
                android:id="@+id/et_weightage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:paddingHorizontal="10dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:hint="@string/enter_weightage"
                android:visibility="visible" />


            <EditText
                android:id="@+id/et_question"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:paddingHorizontal="10dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:hint="@string/enter_question"
                android:visibility="visible" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/rectangle_border_gray_corner_radius"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:ellipsize="end"
                        android:fontFamily="@font/ubuntu_medium"
                        android:lines="1"
                        android:padding="7dp"
                        android:text="@string/attachment"
                        android:textColor="#545454" />

                     <ImageView
                        android:id="@+id/ivFileRemove"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:visibility="visible"
                        app:srcCompat="@drawable/tb_doc_picker_ic_icon_cancel" />

                </LinearLayout>


                <TextView
                    android:id="@+id/tvAddAttac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/browse_file"
                    app:drawableRightCompat="@drawable/ic_add_green_fil" />

            </RelativeLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Question Bank"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_15sdp"
                />



        </LinearLayout>


    </LinearLayout>
</layout>