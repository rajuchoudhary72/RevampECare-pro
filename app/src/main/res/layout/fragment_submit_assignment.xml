<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="assData"
            type="com.app.ecarepro.model.Assignment" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.assignment.submit_assignment.SubmitAssignmentFragment">


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            app:layout_collapseMode="pin"
            app:titleCentered="true"
            android:elevation="8dp"
            app:navigationIcon="@drawable/ic_arrow_back_24px"

            app:title="Submit Assignment"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            android:theme="@style/MyThemeOverlay_Toolbar"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white" />


        <LinearLayout
            android:id="@+id/llMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical"
            android:layout_below="@+id/toolbar"

            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/subject"

                    />

                <TextView
                    android:id="@+id/tvSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/grey_60"
                    android:text="@{assData.subject}"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/title"

                    />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/grey_60"
                    android:text="@{assData.title}"
                    />

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:autoLink="web"
                    android:fontFamily="@font/ubuntu_light"
                    android:linksClickable="true"
                    android:textSize="14sp"
                     android:textColor="@color/grey_60"
                    android:text="@{assData.asgData}"
                    />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/assigned_on"

                    />

                <TextView
                    android:id="@+id/tvAssignmentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/grey_60"
                    android:text="@{assData.asgDate}"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/to_be_submitted_on"

                    />

                <TextView
                    android:id="@+id/tvSubmittedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/grey_60"
                    android:text="@{assData.submitDate}"
                    />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/llFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/rectangle_border_gray_corner_radius"
                 android:padding="7dp"
                android:visibility="gone"

                 >

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:fontFamily="@font/ubuntu_medium"
                    android:lines="1"
                    android:padding="7dp"
                    android:text="@string/attachment"
                    android:textColor="#545454" />

                <ImageView
                    android:id="@+id/ivFileRemove"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:visibility="visible"
                    app:srcCompat="@drawable/tb_doc_picker_ic_icon_cancel" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true">

            <RelativeLayout
                android:id="@+id/rel_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/ed_around"
                android:background="@color/grey_light">

                <EditText
                    android:id="@+id/et_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@drawable/edit_text_bg_post_answer"
                    android:fontFamily="@font/ubuntu_medium"
                    android:hint="@string/type_your_message_with_word_limit"
                    android:padding="7dp"
                    android:drawablePadding="5dp"
                    android:textColorHint="@color/grey_60"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine" />

                <RelativeLayout
                    android:id="@+id/img_post_answer"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp">

                    <ImageButton
                        android:id="@+id/post_answer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:enabled="false"
                        android:background="@color/white"
                        android:src="@drawable/send_icon_light" />


                </RelativeLayout>


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/grey_light"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_browse_photo"
                        android:layout_width="0dp"
                        android:layout_weight="0.8"
                        android:layout_height="wrap_content"
                        android:drawablePadding="3dp"
                        android:fontFamily="@font/ubuntu_medium"
                        android:padding="5dp"
                        android:text="@string/camera_amp_browse_photo"
                        app:drawableTopCompat="@drawable/ic_camera"
                        android:gravity="bottom|center" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/grey_light"
                        android:layout_marginVertical="3dp" />

                    <TextView
                        android:layout_weight="1"
                        android:id="@+id/tv_browse_file"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:drawablePadding="3dp"
                        android:fontFamily="@font/ubuntu_medium"
                        android:padding="5dp"
                        android:text="@string/attach_photo_pdf_doc"
                        app:drawableTopCompat="@drawable/ic_add_account"
                        android:gravity="bottom|center" />

                </LinearLayout>

            </LinearLayout>


        </LinearLayout>


    </RelativeLayout>
</layout>