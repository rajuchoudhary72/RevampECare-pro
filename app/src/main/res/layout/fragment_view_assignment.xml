<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:fitsSystemWindows="true"
        android:layout_height="match_parent"
        tools:context=".ui.assignment.staff.viewAssignment.ViewAssignmentFragment">

  <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
         >


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            android:elevation="8dp"
            android:theme="@style/MyThemeOverlay_Toolbar"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:title="Assignment Details"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white" />


      <androidx.core.widget.NestedScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              >

              <LinearLayout
                  android:id="@+id/llMain"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_margin="10dp"
                  android:orientation="vertical"

                  >


                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal">

                      <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="@string/general_title_pun"

                          />

                      <TextView
                          android:id="@+id/tvTitle"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_medium"
                          android:textColor="@color/grey_40"
                          android:layout_marginStart="5dp"
                          />

                  </LinearLayout>

                  <RelativeLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content">

                      <TextView
                          android:id="@+id/tvData"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:layout_marginVertical="10dp"
                          android:autoLink="web"
                          android:fontFamily="@font/ubuntu_light"
                          android:linksClickable="true"
                          android:textColor="@color/grey_40"
                          android:textSize="14sp" />

                  </RelativeLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal">

                      <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="@string/assigned_on"
                          />

                      <TextView
                          android:id="@+id/tvAssignmentDate"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_medium"
                          android:layout_marginStart="5dp"
                          android:textColor="@color/grey_40"
                          />

                  </LinearLayout>

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal">

                      <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:text="@string/to_be_submitted_on"

                          />

                      <TextView
                          android:id="@+id/tvSubmittedDate"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_medium"
                          android:layout_marginStart="5dp"
                          android:textColor="@color/grey_40"
                          />

                  </LinearLayout>

              </LinearLayout>

              <com.google.android.material.divider.MaterialDivider
                  android:layout_width="match_parent"
                  android:layout_height="1dp"
                  />


              <LinearLayout
                  android:id="@+id/llEditDelete"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"

                  >

                  <LinearLayout
                      android:id="@+id/llView"
                      android:layout_width="10dp"
                      android:layout_height="wrap_content"
                      android:layout_margin="1dp"
                      android:layout_weight="1"
                      android:gravity="center"
                      android:visibility="visible"
                      >

                      <TextView
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:drawablePadding="5dp"
                          android:fontFamily="@font/ubuntu_medium"
                          android:gravity="center"
                          android:padding="5dp"
                          android:text="@string/view_download"
                          android:textColor="@color/brand_color"
                          app:drawableTint="@color/brand_color"
                          app:drawableLeftCompat="@drawable/baseline_attach_file_24" />

                  </LinearLayout>



              </LinearLayout>

              <com.google.android.material.divider.MaterialDivider
                  android:layout_width="match_parent"
                  android:layout_height="1dp"
                  />



              <LinearLayout
                  android:id="@+id/llAllRemark"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginHorizontal="10dp"
                  android:orientation="horizontal"
                  android:layout_marginTop="25dp"
                  android:layout_marginBottom="@dimen/_5sdp"
                  >

                  <com.google.android.material.textfield.TextInputLayout
                      android:id="@+id/til_text_filed_all_remark"
                      style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="6"
                      android:textColorHint="@color/grey_40"
                      android:hint="Remark"

                      >

                      <com.google.android.material.textfield.TextInputEditText
                          android:id="@+id/textFiledAllRemark"
                          android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_regular"
                          />

                  </com.google.android.material.textfield.TextInputLayout>
                  <TextView
                      android:id="@+id/tv_copy_to_all"
                      android:layout_width="0dp"
                      android:layout_weight="4"
                      android:layout_height="wrap_content"
                      android:text="@string/copy_to_all"
                      android:textSize="@dimen/_16sdp"
                      android:layout_marginStart="@dimen/_10sdp"
                      />

              </LinearLayout>

              <LinearLayout
                  android:id="@+id/ll_submit_notSubmit"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:background="@color/md_theme_light_primary"
                  android:gravity="center"
                  android:orientation="vertical"
                  android:layout_marginTop="@dimen/_5sdp">

                  <com.google.android.material.button.MaterialButtonToggleGroup
                      android:id="@+id/toggleButton_type_noti"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:gravity="center"
                      app:checkedButton="@id/btn_submit"
                      app:selectionRequired="true"
                      app:singleSelection="true"

                      >

                      <com.google.android.material.button.MaterialButton
                          android:id="@+id/btn_submit"
                          style="?attr/materialButtonOutlinedStyle"
                          android:layout_width="0dp"
                          android:layout_weight="1"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_regular"
                          android:text="@string/general_submitted"
                          app:strokeColor="@color/white"
                          app:rippleColor="@color/white"

                          app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                      <com.google.android.material.button.MaterialButton
                          android:id="@+id/btn_notSubmit"
                          style="?attr/materialButtonOutlinedStyle"
                          android:layout_width="0dp"
                          android:layout_weight="1"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_regular"
                          android:text="@string/general_not_submitted"
                          app:strokeColor="@color/white"
                          app:rippleColor="@color/white"
                          app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                      <com.google.android.material.button.MaterialButton
                          android:id="@+id/btn_late_submit"
                          style="?attr/materialButtonOutlinedStyle"
                          android:layout_width="0dp"
                          android:layout_weight="1"
                          android:layout_height="wrap_content"
                          android:fontFamily="@font/ubuntu_regular"
                          android:text="@string/late_submitted"
                          app:strokeColor="@color/white"
                          app:rippleColor="@color/white"
                          android:visibility="gone"
                          app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />


                  </com.google.android.material.button.MaterialButtonToggleGroup>



              </LinearLayout>



              <TextView
                  android:id="@+id/tv_details_assi"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center"
                  android:layout_margin="10dp"
                  />


              <androidx.recyclerview.widget.RecyclerView
                  android:id="@+id/rv_submit_list"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="@dimen/_45sdp"
                  tools:listitem="@layout/not_submitted_stu_list" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_100sdp"/>

          </LinearLayout>

      </androidx.core.widget.NestedScrollView>

    </LinearLayout>

        <TextView
            android:id="@+id/tv_save_remark"
            android:layout_width="match_parent"
             android:layout_height="@dimen/_45sdp"
            android:background="@color/brand_color"
            android:baselineAligned="false"
            android:fontFamily="@font/ubuntu_medium"
            android:gravity="center"
            android:orientation="horizontal"
            android:text="@string/save_remark"
            android:textColor="@color/white"
             android:layout_alignParentBottom="true"
            />


    </RelativeLayout>
</layout>