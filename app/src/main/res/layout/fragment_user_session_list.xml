<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

   <data>

   </data>

   <RelativeLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:fitsSystemWindows="true"
       android:background="@color/background_dashboard"
       tools:context=".ui.user_session_list.UserSessionListFragment">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

         <include
             android:id="@+id/include_toolbar"
             layout="@layout/common_toolbar" />

         <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="@string/session_text_info_holder"
             android:layout_marginHorizontal="@dimen/_20sdp"
             android:textStyle="bold"
             android:layout_gravity="center"
             android:layout_marginVertical="@dimen/_15sdp" />

         <androidx.core.widget.NestedScrollView
             android:layout_width="match_parent"
             android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

               <androidx.cardview.widget.CardView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   app:cardElevation="0dp"
                   android:layout_margin="@dimen/_15sdp"
                   app:cardCornerRadius="@dimen/_15sdp">

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="vertical">

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal"
                         android:layout_marginVertical="@dimen/_15sdp"
                         android:layout_marginHorizontal="@dimen/_15sdp">

                        <ImageView
                            android:id="@+id/iv_holder_mobile"
                            android:layout_width="@dimen/_35sdp"
                            android:layout_height="@dimen/_35sdp"
                            android:src="@drawable/smartphone_ic"
                            android:layout_gravity="center" />

                        <TextView
                            android:id="@+id/tv_mobile_session"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_16sdp"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_gravity="center" />


                     </LinearLayout>

                     <androidx.recyclerview.widget.RecyclerView
                         android:id="@+id/recycler_mobile_session"
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:orientation="vertical"
                         app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                         tools:listitem="@layout/session_list_item"
                         app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                         />


                  </LinearLayout>
               </androidx.cardview.widget.CardView>

               <androidx.cardview.widget.CardView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   app:cardElevation="0dp"
                   android:layout_margin="@dimen/_15sdp"
                   app:cardCornerRadius="@dimen/_15sdp">

                  <LinearLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:orientation="vertical">

                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal"
                         android:layout_marginVertical="@dimen/_15sdp"
                         android:layout_marginHorizontal="@dimen/_15sdp">

                        <ImageView
                            android:id="@+id/iv_holder_web"
                            android:layout_width="@dimen/_35sdp"
                            android:layout_height="@dimen/_35sdp"
                            android:src="@drawable/imac_ic"
                            android:layout_gravity="center" />

                        <TextView
                            android:id="@+id/tv_session_in_web"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/_16sdp"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_gravity="center" />


                     </LinearLayout>

                     <androidx.recyclerview.widget.RecyclerView
                         android:id="@+id/recycler_session_web"
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:orientation="vertical"
                         app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                         tools:listitem="@layout/session_list_item"
                         app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                         />


                  </LinearLayout>
               </androidx.cardview.widget.CardView>


               <Button
                   android:id="@+id/btn_logout_device"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/logout_all_devices"
                   android:layout_marginHorizontal="@dimen/_15sdp"
                   android:layout_marginBottom="@dimen/_15sdp"
                   android:layout_gravity="end"
                   />


            </LinearLayout>

         </androidx.core.widget.NestedScrollView>

      </LinearLayout>

      <TextView
          android:id="@+id/tv_no_data"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_centerInParent="true"
          android:fontFamily="@font/ubuntu_medium"
          android:layout_gravity="center"
          android:gravity="center"
          android:visibility="gone"
          android:text="@string/no_notice_available"
          android:textSize="16sp"

          />


   </RelativeLayout>
</layout>