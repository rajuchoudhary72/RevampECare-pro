<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.app.ecarepro.ui.taskmanager.tasklist.AddTaskListViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:paddingTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/round_close_24"
            app:navigationIconTint="@color/white"
            app:title="Add Task Type"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium"
            app:titleTextColor="@color/white" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/horizontal_margin"
            android:hint="Task Name"
            app:layout_constraintEnd_toStartOf="@+id/til_start_date"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_assign_to">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="@={viewModel.name}" />

        </com.google.android.material.textfield.TextInputLayout>



        <LinearLayout
            android:id="@+id/til_staff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/horizontal_margin"
            android:background="@drawable/bg_outline_round_corner_grey"
            android:gravity="center_vertical"
            android:minHeight="55dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/til_start_date"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_task_list">

            <TextView
                android:id="@+id/selectStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:background="@color/transparent"
                android:focusable="false"
                android:inputType="none"
                android:text="@string/select_staff_types"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                app:drawableEndCompat="@drawable/ic_arrow_right_black" />


            <TextView
                android:id="@+id/textStaffTypes"
                android:layout_width="match_parent"
                android:fontFamily="@font/calibri_regular"
                android:textSize="@dimen/_15sdp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:visibility="gone" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/til_assign_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/horizontal_margin"
            android:background="@drawable/bg_outline_round_corner_grey"
            android:gravity="center_vertical"
            android:minHeight="55dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/til_start_date"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_task_list">

            <TextView
                android:id="@+id/selectAssinee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:background="@color/transparent"
                android:focusable="false"
                android:inputType="none"
                android:text="@string/select_assignee"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                app:drawableEndCompat="@drawable/ic_arrow_right_black" />


            <com.app.ecarepro.ui.views.CarouselNoSnap
                android:id="@+id/assignee_carousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_task_assignee_carousel_item" />


        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCreateTask"
            android:text="Create Task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/horizontal_margin" />


    </LinearLayout>
</layout>