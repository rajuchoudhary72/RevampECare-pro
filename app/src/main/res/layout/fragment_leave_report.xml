<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.leave.leave_report.LeaveReportFragment">

        <include
            android:id="@+id/include_toolbar"
            layout="@layout/common_toolbar"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@+id/include_toolbar"

            >
        <LinearLayout
            android:id="@+id/ll_leave_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_light_primary"
            android:gravity="center"
            android:fitsSystemWindows="true"
            android:orientation="vertical"
            app:layout_collapseMode="parallax"
            app:layout_scrollFlags="scroll|enterAlways"
            >

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleButton_type_leave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                app:checkedButton="@id/btn_pen"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pen"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/pending"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    android:textSize="11sp"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_app"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/approved"
                    android:textSize="11sp"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rej"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/rejected"
                    android:textSize="11sp"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/general_cancel"
                    android:textSize="11sp"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />


            </com.google.android.material.button.MaterialButtonToggleGroup>


        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_all_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/select_all"
            />


            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_leave_report"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                        tools:listitem="@layout/leave_report_list_item"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_all_approve_rej"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_alignParentBottom="true"
            >

            <TextView
                android:id="@+id/tv_approve"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/background_box_rectangle_green"
                android:gravity="center"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@string/approve"
                android:textColor="@color/white"
                app:fontFamily="@font/ubuntu_bold" />

            <View
                android:id="@+id/view_two"
                android:layout_width="@dimen/_2sdp"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_reject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_2sdp"
                android:layout_weight="1"
                android:background="@drawable/background_box_rectangle_red"
                android:gravity="center"
                android:paddingVertical="@dimen/_8sdp"
                android:text="@string/reject"
                android:textColor="@color/white"
                app:fontFamily="@font/ubuntu_bold" />


        </LinearLayout>


        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/ubuntu_medium"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/general_no_data_found"
            android:textSize="16sp"

            />




    </RelativeLayout>
</layout>