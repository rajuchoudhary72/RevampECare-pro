<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_co"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:targetApi="jelly_bean">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/rl_leave_details"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:background="@color/brand_color">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sdp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rel_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_leave_details"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:background="@color/white">
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:paddingStart="@dimen/_10sdp"
                android:textColor="@color/module"
                android:textSize="@dimen/_16sdp"
                android:paddingLeft="@dimen/_10sdp"
                android:paddingRight="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:paddingTop="@dimen/_15sdp"
                android:paddingBottom="@dimen/_15sdp"/>
        </RelativeLayout>

        <View
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_below="@+id/rel_id"
            android:background="@color/light_grey" />

        <LinearLayout
            android:id="@+id/ll_normal_update"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_below="@+id/view1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/_4sdp"
            android:visibility="gone"
            android:paddingTop="@dimen/_4sdp">


            <RelativeLayout
                android:id="@+id/rel_normal_update_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_weight="0.9"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_critical_update_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/general_cancel"
                    android:textColor="@color/module"
                    android:textSize="@dimen/_17sdp" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="0.005"
                android:background="@color/light_grey"
                android:gravity="center">

                <View
                    android:id="@+id/view"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/light_grey"

                    />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rel_normal_update_update"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_weight="0.9"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_normal_update_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/upgrade_now"
                    android:textColor="@color/module"
                    android:textSize="@dimen/_17sdp" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_critical_update"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_below="@+id/view1"
            android:layout_marginBottom="@dimen/_10sdp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/_4sdp"
            android:paddingTop="@dimen/_4sdp"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/rel_critical_update_update"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_weight="0.9"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_critical_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/upgrade_now"
                    android:textColor="@color/module"
                    android:textSize="@dimen/_17sdp" />
            </RelativeLayout>
        </LinearLayout>

    </RelativeLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>

