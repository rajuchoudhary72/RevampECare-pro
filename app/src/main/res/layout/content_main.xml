<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dashboard"
        android:focusable="true"
        android:clickable="true"
        android:importantForAccessibility="yes"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <fragment
            android:id="@+id/nav_host_fragment_content_main"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@+id/rl_bottom_navigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navGraph="@navigation/nav_graph" />


        <FrameLayout
            android:id="@+id/more_item_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="140dp"
            android:layout_marginBottom="-35dp"
            android:background="@drawable/bg_all_service"
            android:paddingHorizontal="16dp"
            android:paddingTop="35dp"
            android:paddingBottom="70dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/rl_bottom_navigation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:spanCount="3"
            tools:itemCount="100"
            tools:listitem="@layout/item_card_option">

            <com.airbnb.epoxy.EpoxyRecyclerView
                android:id="@+id/recycler_view_more_options"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3"
                tools:itemCount="100"
                tools:listitem="@layout/item_card_option" />
        </FrameLayout>




        <RelativeLayout
            android:id="@+id/rl_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/bottom_nav_background"
             >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <RelativeLayout
                    android:id="@+id/rl_main_search"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="@dimen/_30sdp"
                    android:background="@drawable/bg_round_corner_white"
                    android:layout_marginTop="25dp"
                    >

                     <ImageView
                         android:id="@+id/iv_search"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:src="@drawable/ic_search_new"
                         android:layout_centerVertical="true"
                         android:layout_marginStart="25dp"
                         app:tint="@color/brand_color" />

                    <TextView
                        android:id="@+id/search_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:text="@string/global_search"
                        android:textColor="@color/grey_40"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/iv_search"
                        android:layout_marginStart="5dp"
                        />

                    <ImageView
                        android:id="@+id/iv_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="25dp"
                        android:contentDescription="@string/setting_screen_open"
                        android:padding="@dimen/_5sdp"
                        android:layout_marginEnd="15dp"
                        android:src="@drawable/ic_setting_new"
                        app:tint="@color/brand_color" />


                </RelativeLayout>

                <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:id="@+id/bottomNavigationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/transparent"
                    app:itemActiveIndicatorStyle="@android:color/transparent"
                    app:itemIconTint="@color/bnv_tab_item_foreground"
                    app:itemTextColor="@color/bnv_tab_item_foreground"
                    app:labelVisibilityMode="labeled"
                    app:menu="@menu/bottom_navigation_menu"
                    tools:visibility="visible" />


            </LinearLayout>


        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>