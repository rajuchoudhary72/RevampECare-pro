<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.report.student_att_report.StudentAttRepoFragment">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            android:elevation="8dp"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Attendance Report"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white" />


        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_tat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/_45sdp"
            android:background="@color/white"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/grey_light"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/ll_start"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_15sdp"
                        android:paddingTop="@dimen/_7sdp"
                        android:paddingBottom="@dimen/_7sdp"
                        tools:ignore="RtlSymmetry">

                        <TextView
                            android:id="@+id/tv_from"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/from_"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_9sdp" />


                        <TextView
                            android:id="@+id/tv_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:text="@string/from_date"
                            android:textSize="@dimen/_11sdp"
                            android:fontFamily="@font/ubuntu_bold"
                            android:textColor="@color/grey_60"/>
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/_9sdp"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/grey_60"
                        android:textSize="@dimen/_9sdp" />

                    <LinearLayout
                        android:id="@+id/ll_end"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/_7sdp"
                        android:paddingBottom="@dimen/_7sdp">

                        <TextView
                            android:id="@+id/tv_to"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/to_"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_9sdp" />


                        <TextView
                            android:id="@+id/tv_end_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:text="@string/to_date"
                            android:textSize="@dimen/_11sdp"
                            android:fontFamily="@font/ubuntu_bold"
                            android:textColor="@color/grey_60" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                     android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@color/white"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.2"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:text="School Days"
                            android:textSize="@dimen/_12sdp"
                            android:gravity="center"
                            android:textColor="@color/grey_60" />

                        <TextView
                            android:id="@+id/schoolday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/grey_60" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:text="@string/present"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/green" />

                        <TextView
                            android:id="@+id/present_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/green"

                            />

                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:text="@string/absent"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/red" />

                        <TextView
                            android:id="@+id/absent_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/red"

                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:text="@string/leave"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/att_leave_color" />

                        <TextView
                            android:id="@+id/leave_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/att_leave_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_late"
                        android:layout_width="0dp"
                        android:layout_height="fill_parent"
                        android:layout_weight="0.8"
                        android:background="@color/white"
                        android:gravity="center"
                        android:visibility="visible"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:text="@string/late"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/att_late_color" />

                        <TextView
                            android:id="@+id/tv_late_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/att_late_color" />

                    </LinearLayout>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_7sdp"
                    android:background="@color/grey_light" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attendance_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/from_till_today_text"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:background="@color/grey_light"
                        android:gravity="center"
                        android:text="@string/from_s_till_today"
                        android:textColor="@color/grey_60"
                        android:textSize="@dimen/_15sdp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@color/white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:text="@string/total_school_college_days"
                            android:textColor="@color/grey_60"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_15sdp" />

                        <TextView
                            android:id="@+id/total_school_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:textColor="@color/grey_60"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_15sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:background="@color/white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:text="@string/total_present"
                            android:textColor="@color/green"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_15sdp" />

                        <TextView
                            android:id="@+id/total_present_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:textColor="@color/green"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textSize="@dimen/_15sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:background="@color/white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:text="@string/total_absent"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/red"
                            android:textSize="@dimen/_15sdp" />

                        <TextView
                            android:id="@+id/total_absent_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/red"
                            android:textSize="@dimen/_15sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:background="@color/white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:text="@string/total_leave"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/att_leave_color"
                            android:textSize="@dimen/_15sdp" />

                        <TextView
                            android:id="@+id/total_leave_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/att_leave_color"
                            android:textSize="@dimen/_15sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_late_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:background="@color/white"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:text="@string/total_late"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/att_late_color"
                            android:textSize="@dimen/_15sdp" />

                        <TextView
                            android:id="@+id/tv_late_month_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_20sdp"
                            android:fontFamily="@font/ubuntu_regular"
                            android:textColor="@color/att_late_color"
                            android:textSize="@dimen/_15sdp" />


                    </RelativeLayout>



                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="@dimen/_7sdp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="fill_parent"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_7sdp">

                            <TextView
                                android:id="@+id/per_present"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:background="@drawable/circle_present"
                                android:gravity="center"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_20sdp" />

                            <TextView
                                android:id="@+id/text4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:text="@string/present"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/green"
                                android:textSize="@dimen/_15sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="fill_parent"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_7sdp">

                            <TextView
                                android:id="@+id/per_absent"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:background="@drawable/circle_absent"
                                android:gravity="center"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_20sdp" />

                            <TextView
                                android:id="@+id/text5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/absent"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/red"
                                android:textSize="@dimen/_15sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="fill_parent"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_7sdp">

                            <TextView
                                android:id="@+id/per_leave"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:background="@drawable/circle_leave"
                                android:gravity="center"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_20sdp" />


                            <TextView
                                android:id="@+id/tv_leave"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/leave"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/att_leave_color"
                                android:textSize="@dimen/_15sdp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_late_circle"
                            android:layout_width="match_parent"
                            android:layout_height="fill_parent"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/_7sdp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/tv_late_circle"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:background="@drawable/circle_late"
                                android:gravity="center"
                                android:fontFamily="@font/ubuntu_regular"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_20sdp" />

                            <TextView
                                android:id="@+id/tv_label_lt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/late"
                                android:textColor="@color/att_late_color"
                                android:textSize="@dimen/_15sdp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </LinearLayout>
</layout>