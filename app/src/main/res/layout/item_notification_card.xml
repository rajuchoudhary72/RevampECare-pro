<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:contentPadding="12dp"
        app:strokeColor="@color/grey_10"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_horne"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/calibri_bold"
                android:layout_marginStart="5dp"
                android:text="Notice"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/image"
                app:layout_constraintTop_toTopOf="@id/image" />

            <TextView
                android:id="@+id/sub_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet..."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:fontFamily="@font/calibri_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/title"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="4dp"
                android:fontFamily="@font/calibri_light"
                android:gravity="center"
                android:text="23 May 2034 "
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="#9FA297"
                app:layout_constraintStart_toStartOf="@+id/title"
                app:layout_constraintTop_toBottomOf="@+id/sub_title"
                app:drawableTint="#9FA297"
                app:drawableStartCompat="@drawable/ic_calendar" />

            <TextView
                android:fontFamily="@font/calibri_light"
                android:layout_marginStart="8dp"
                android:id="@+id/time"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:text="23 May 2034 "
                android:textColor="#9FA297"
                app:layout_constraintStart_toEndOf="@+id/date"
                app:layout_constraintTop_toBottomOf="@+id/sub_title"
                app:drawableTint="#9FA297"
                app:drawableStartCompat="@drawable/ic_schedule_24px" />


            <TextView
                android:textColor="@color/brand_color"
                android:drawableEnd="@drawable/ic_arrow_right"
                app:layout_constraintEnd_toEndOf="parent"
                android:drawablePadding="8dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/time"
                android:fontFamily="@font/calibri_regular"
                android:text="View"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>