<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.appointment.AppointmentReportFragment">



        <LinearLayout
            android:id="@+id/ll_toolbar_appointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/include_toolbar"
                layout="@layout/common_toolbar"
                />


            <LinearLayout
                android:id="@+id/ll_toole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/md_theme_light_primary"
                android:fitsSystemWindows="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_collapseMode="parallax"
                android:visibility="gone"
                app:layout_scrollFlags="scroll|enterAlways">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleButton_all_me"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center"
                    android:weightSum="2"
                    app:checkedButton="@id/btn_all"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_all"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ubuntu_regular"
                        android:text="@string/all"
                        app:rippleColor="@color/white"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall"

                        app:strokeColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_me"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ubuntu_regular"
                        android:text="@string/only_me"
                        app:rippleColor="@color/white"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall"
                        app:strokeColor="@color/white" />


                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleButton_today_upcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center"
                    android:weightSum="2"
                    app:checkedButton="@id/btn_today"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_today"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ubuntu_regular"
                        android:text="@string/general_today"
                        app:rippleColor="@color/white"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall"

                        app:strokeColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_class_noti"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ubuntu_regular"
                        android:text="@string/upcoming"
                        app:rippleColor="@color/white"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall"
                        app:strokeColor="@color/white" />


                </com.google.android.material.button.MaterialButtonToggleGroup>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/background_box_rectangle_white_round">

                    <TextView
                        android:id="@+id/dateFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/ubuntu_regular"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/general_from_date"
                        android:textColor="@color/grey_40"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="-" />

                    <TextView
                        android:id="@+id/dateTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="@font/ubuntu_regular"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/general_to_date"
                        android:textColor="@color/grey_40"
                        android:textSize="16sp" />

                </RelativeLayout>





            </LinearLayout>


        </LinearLayout>



        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="center"
            app:tabIndicatorFullWidth="true"
            app:tabMode="scrollable"
            android:layout_alignParentBottom="true"
            />

        <androidx.viewpager2.widget.ViewPager2
                android:layout_below="@+id/ll_toolbar_appointment"
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/tabLayout"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />



    </RelativeLayout>
</layout>