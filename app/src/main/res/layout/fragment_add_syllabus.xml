<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:background="@color/background_dashboard"
        tools:context=".ui.syllabus.teacher.add_syllabus.AddSyllabusFragment">

        <include
            android:id="@+id/include_toolbar"
            layout="@layout/common_toolbar"
            />


        <LinearLayout
            android:id="@+id/llMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            >

            <RadioGroup
                android:id="@+id/rb_group_syllabus_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginVertical="@dimen/_10sdp"
                >
                <RadioButton
                    android:id="@+id/rbClassWise"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/class_wise_default"
                    android:textColor="@color/black"
                    android:checked="true"
                    />
                <RadioButton
                    android:id="@+id/rb_section_wise"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/section_wise_recommended_only_for_those_classes_where_different_sections_have_different_subjects_or_syllabus"
                    android:textColor="@color/black"
                    android:layout_gravity="start"
                    android:gravity="start"

                    />

            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >


                <TextView
                    android:id="@+id/tvSelectClass"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_box_rectangle_white"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="@string/lbl_select_class"

                    android:visibility="visible"
                    app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

                <TextView
                    android:id="@+id/tvSelectSection"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_box_rectangle_white"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="@string/general_select_section"
                    android:visibility="gone"
                    app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSelectSubject"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/background_box_rectangle_white"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="@string/select_subject"
                    android:visibility="visible"
                    app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


            </LinearLayout>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="8dp"
                android:backgroundTint="@color/white"
                android:background="@drawable/background_box_rectangle_white"
                android:fontFamily="@font/ubuntu_light"
                android:gravity="center_vertical"
                android:hint="@string/general_enter_title"
                android:lines="4"
                android:maxLines="6"
                android:padding="10dp"
                android:visibility="visible" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llFile"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/rectangle_border_gray_corner_radius"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:ellipsize="end"
                        android:fontFamily="@font/ubuntu_medium"
                        android:lines="1"
                        android:padding="7dp"
                        android:text="@string/general_attachment"
                        android:textColor="#545454" />

                    <ImageView
                        android:id="@+id/ivFileRemove"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:visibility="visible"
                        app:srcCompat="@drawable/tb_doc_picker_ic_icon_cancel" />

                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_attachemnt_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/grey_light"
                android:layout_marginBottom="@dimen/_15sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_browse_photo"
                        android:layout_width="0dp"
                        android:layout_weight="0.8"
                        android:layout_height="wrap_content"
                        android:drawablePadding="3dp"
                        android:fontFamily="@font/ubuntu_medium"
                        android:padding="5dp"
                        android:text="@string/browse_photo"
                        app:drawableTopCompat="@drawable/ic_camera"
                        android:gravity="bottom|center" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/grey_light"
                        android:layout_marginVertical="3dp" />

                    <TextView
                        android:layout_weight="1"
                        android:id="@+id/tv_browse_file"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:drawablePadding="3dp"
                        android:fontFamily="@font/ubuntu_medium"
                        android:padding="5dp"
                        android:text="@string/attach_photo_pdf_doc"
                        app:drawableTopCompat="@drawable/ic_add_account"
                        android:gravity="bottom|center" />

                </LinearLayout>

            </LinearLayout>



            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="12dp"
                android:fontFamily="@font/ubuntu_light"
                android:text="@string/lbl_submit"
                android:textColor="@color/white" />


        </LinearLayout>

    </LinearLayout>
</layout>