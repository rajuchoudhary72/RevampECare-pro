<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"

    >

    <RelativeLayout
        android:id="@+id/rlHeading"
        android:layout_width="match_parent"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:layout_height="@dimen/_45sdp">

        <TextView
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/general_filter_by"
            android:textColor="@color/module"
            android:textSize="@dimen/_18sdp" />
        <ImageView
            android:id="@+id/ivCross"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            app:srcCompat="@drawable/cross1"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>



   <LinearLayout
       android:id="@+id/llMainView"
       android:layout_below="@+id/rlHeading"
       android:layout_above="@+id/llButton"
       android:layout_width="match_parent"
       android:orientation="vertical"
       android:paddingLeft="@dimen/_10sdp"
       android:paddingRight="@dimen/_10sdp"
       android:layout_height="match_parent">
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/date_range"
           android:layout_marginTop="@dimen/_15sdp"
           android:textColor="@color/module"
           android:textSize="@dimen/_12sdp"/>
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@drawable/background_box_rectangle_grey"
           android:gravity="center_vertical">

           <LinearLayout
               android:id="@+id/llFilterStart"
               android:layout_width="0dp"
               android:layout_height="@dimen/_45sdp"
               android:layout_weight="1"
               android:gravity="center_vertical"
               android:orientation="vertical"
               android:paddingStart="@dimen/_15sdp"
               android:paddingTop="@dimen/_7sdp"
               android:paddingBottom="@dimen/_7sdp"
               tools:ignore="RtlSymmetry">

               <TextView
                   android:id="@+id/tvFilterStart"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:gravity="center"
                   android:text="@string/general_from_pun"
                   android:fontFamily="@font/ubuntu_regular"
                   android:textColor="@color/module"
                   android:textSize="@dimen/_9sdp" />


               <TextView
                   android:id="@+id/tvFilterStartDate"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:ellipsize="end"
                   android:gravity="center"
                   android:text="@string/_02_may_2018"
                   android:textSize="@dimen/_11sdp"
                   android:fontFamily="@font/ubuntu_bold"
                   android:textColor="@color/module"/>
           </LinearLayout>

           <View
               android:layout_width="@dimen/_9sdp"
               android:layout_height="@dimen/_1sdp"
               android:background="@color/module"
               android:textSize="@dimen/_9sdp" />

           <LinearLayout
               android:id="@+id/llFilterEnd"
               android:layout_width="0dp"
               android:layout_height="@dimen/_45sdp"
               android:layout_weight="1"
               android:gravity="center_vertical"
               android:orientation="vertical"
               android:paddingTop="@dimen/_7sdp"
               android:paddingBottom="@dimen/_7sdp">

               <TextView
                   android:id="@+id/tv_to"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:gravity="center"
                   android:text="@string/general_to_pun"
                   android:fontFamily="@font/ubuntu_regular"
                   android:textColor="@color/module"
                   android:textSize="@dimen/_9sdp" />


               <TextView
                   android:id="@+id/tvFilterEnd"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:ellipsize="end"
                   android:gravity="center"
                   android:textSize="@dimen/_11sdp"
                   android:fontFamily="@font/ubuntu_bold"
                   android:textColor="@color/module" />
           </LinearLayout>
       </LinearLayout>
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/sender"
           android:layout_marginTop="@dimen/_10sdp"
           android:textColor="@color/module"
           android:textSize="@dimen/_12sdp"/>
       <RadioGroup
           android:id="@+id/rgSender"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@drawable/background_box_rectangle_grey"
           android:orientation="horizontal"
           android:visibility="visible"
           android:layout_marginTop="@dimen/_5sdp"
           android:weightSum="4">
           <RadioButton
               android:id="@+id/rgSenderRb1"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_margin="@dimen/_3sdp"
               android:layout_weight="1"
               android:padding="@dimen/_4sdp"
               android:text="@string/all"
               android:checked="true"
               android:textColor="@color/module"

               />
           <RadioButton
               android:id="@+id/rgSenderRb2"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/general_staff"
                android:fontFamily="@font/ubuntu_regular" />
           <RadioButton
               android:id="@+id/rgSenderRb3"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/general_parent"
                android:fontFamily="@font/ubuntu_regular" />
           <RadioButton
               android:id="@+id/rgSenderRb4"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/general_student"
                android:fontFamily="@font/ubuntu_regular" />
       </RadioGroup>
       <EditText
           android:id="@+id/etSenderName"
           android:layout_width="match_parent"
           android:layout_height="@dimen/_37sdp"
           android:hint="@string/enter_the_sender_name_if_any"
           android:layout_marginTop="@dimen/_5sdp"
           android:padding="@dimen/_5sdp"
           android:visibility="gone"
           android:background="@drawable/edit_text_background"/>

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/recipient"
           android:layout_marginTop="@dimen/_10sdp"
           android:textColor="@color/module"
           android:textSize="@dimen/_12sdp"/>
       <RadioGroup
           android:id="@+id/rgRecipient"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@drawable/background_box_rectangle_grey"
           android:orientation="horizontal"
           android:visibility="visible"
           android:layout_marginTop="@dimen/_5sdp"
           android:weightSum="4">
           <RadioButton
               android:id="@+id/rgRecipientRb1"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_margin="@dimen/_3sdp"
               android:layout_weight="1"
               android:padding="@dimen/_4sdp"
               android:text="@string/all"
               android:checked="true"
               android:textColor="@color/module"
                />
           <RadioButton
               android:id="@+id/rgRecipientRb2"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/general_staff"
                android:fontFamily="@font/ubuntu_regular" />
           <RadioButton
               android:id="@+id/rgRecipientRb3"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/general_parent"
                android:fontFamily="@font/ubuntu_regular" />
           <RadioButton
               android:id="@+id/rgRecipientRb4"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/general_student"
                android:fontFamily="@font/ubuntu_regular" />
       </RadioGroup>
       <EditText
           android:id="@+id/etRecipientName"
           android:layout_width="match_parent"
           android:layout_height="@dimen/_37sdp"
           android:hint="@string/enter_the_recipient_name_if_any"
           android:padding="@dimen/_5sdp"
           android:visibility="gone"
           android:layout_marginTop="@dimen/_5sdp"
           android:background="@drawable/edit_text_background"/>

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/has_the_word_in_the_message"
           android:layout_marginTop="@dimen/_10sdp"
           android:textColor="@color/module"
           android:textSize="@dimen/_12sdp"/>
       <RadioGroup
           android:id="@+id/rgHasWord"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@drawable/background_box_rectangle_grey"
           android:orientation="horizontal"
           android:visibility="visible"
           android:layout_marginTop="@dimen/_5sdp"
           android:weightSum="4">
           <RadioButton
               android:id="@+id/rgAnyRb1"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_margin="@dimen/_3sdp"
               android:layout_weight="1"
               android:padding="@dimen/_4sdp"
               android:text="@string/any"

               android:checked="true"
               android:textColor="@color/module"
               android:textSize="@dimen/_14sdp" />
           <RadioButton
               android:id="@+id/rgSpecificRb2"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginBottom="@dimen/_3sdp"
               android:layout_marginStart="@dimen/_3sdp"
               android:layout_marginTop="@dimen/_3sdp"
               android:layout_weight="1"
               android:textColor="@color/module"
               android:padding="@dimen/_4sdp"
               android:text="@string/specific"
               android:textSize="@dimen/_14sdp"
               android:fontFamily="@font/ubuntu_regular" />

       </RadioGroup>
       <EditText
           android:id="@+id/etHasWord"
           android:layout_width="match_parent"
           android:layout_height="@dimen/_37sdp"
           android:hint="@string/has_the_word_in_the_message"
           android:padding="@dimen/_5sdp"
           android:visibility="gone"
           android:layout_marginTop="@dimen/_5sdp"
           android:background="@drawable/edit_text_background"/>
   </LinearLayout>


    <LinearLayout
        android:id="@+id/llButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@color/grey_light"
        android:baselineAligned="false"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">


        <RelativeLayout
            android:id="@+id/rlClearAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0.9"
            android:gravity="center">

            <TextView
                android:id="@+id/tvClearAll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_regular"
                android:paddingBottom="@dimen/_5sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingTop="@dimen/_5sdp"
                android:text="@string/clear_all"
                android:gravity="center"
                android:textAllCaps="false"
                android:textColor="@color/module"
                android:textSize="@dimen/_17sdp"
                tools:ignore="RtlSymmetry" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0.005"
            android:background="@color/white"
            android:gravity="center">

            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/white"

                />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlApply"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0.9"
            android:gravity="center">

            <TextView
                android:id="@+id/tvApply"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_regular"
                android:paddingBottom="@dimen/_5sdp"
                android:paddingStart="@dimen/_10sdp"
                android:paddingTop="@dimen/_5sdp"
                android:text="@string/apply"
                android:gravity="center"
                android:textAllCaps="true"
                android:textColor="@color/module"
                android:textSize="@dimen/_17sdp"
                tools:ignore="RtlSymmetry" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
