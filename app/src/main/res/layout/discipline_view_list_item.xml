<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.cardview.widget.CardView
        android:id="@+id/cv_main"
        android:layout_width="match_parent"
        android:orientation="vertical"
        app:cardBackgroundColor="#FAFAFA"
        app:cardCornerRadius="12sp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginVertical="11dp"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_margin="10sp"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="10"
                android:orientation="horizontal"
                >

                <TextView
                    android:id="@+id/tv_medicine_name"
                    android:layout_width="0dp"
                    android:layout_weight="9"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                     android:textSize="18sp"
                     android:textStyle="bold"
                    android:layout_gravity="center"
                    />

                <ImageView
                    android:id="@+id/iv_delete"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_audio_delete"
                    app:tint="@color/red"
                    android:visibility="gone"
                    />


            </LinearLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="12sp"
                android:weightSum="1">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp"
                     android:layout_alignParentStart="true"
                    />


            </RelativeLayout>

            <LinearLayout
                android:layout_marginTop="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subcategory"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:textStyle="italic"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/_5sdp"

                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_reword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reward"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_diagnosis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:textStyle="italic"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/_5sdp"

                    android:textSize="16sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_marginTop="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instance_wit"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_instance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:textStyle="italic"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/_5sdp"

                    android:textSize="16sp" />

            </LinearLayout>



            <LinearLayout
                android:layout_marginTop="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remark"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_remark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:textStyle="italic"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:textSize="16sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_marginTop="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/issue_by"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_attdent_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="16sp"
                    android:layout_marginStart="@dimen/_5sdp"

                    />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rl_compilance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                >

                <LinearLayout
                    android:id="@+id/ll_compliance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_alignParentEnd="true"
                    >
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_active_compliance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/green"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/_8sdp"

                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/infraction_compliance_active"
                            android:layout_margin="@dimen/_5sdp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_resolved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/grey_60"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/_8sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        >
                        <TextView
                            android:id="@+id/tv_resolved_holder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/complince_not_resolved"
                            android:layout_margin="@dimen/_5sdp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            />
                    </androidx.cardview.widget.CardView>


                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_compliance_not_activated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/grey_60"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="@dimen/_8sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_alignParentEnd="true"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/compliance_not_activated"
                        android:layout_margin="@dimen/_5sdp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        />
                </androidx.cardview.widget.CardView>



            </RelativeLayout>

        </LinearLayout>


    </androidx.cardview.widget.CardView>
</layout>