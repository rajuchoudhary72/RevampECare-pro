<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.gallery.photo.photo_slider.PhotoSliderFragment">

        <ImageView
            android:id="@+id/photoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:layout_above="@+id/ll_bar_likeshare"
            android:contentDescription="@string/photo" />

        <ImageView
            android:id="@+id/iv_video_play"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/_1sdp"
            android:visibility="gone"
            app:srcCompat="@drawable/video_play" />


        <LinearLayout
            android:id="@+id/ll_bar_likeshare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_alignParentBottom="true"
            android:weightSum="3"
            android:background="@color/light_grey"
            android:baselineAligned="false">

            <RelativeLayout
                android:id="@+id/rl_fav"
                android:layout_width="0dp"
                android:layout_height="@dimen/_77sdp"
                android:layout_weight="1.2"
                android:gravity="center"
                android:paddingBottom="@dimen/_14sdp"
                android:paddingTop="@dimen/_14sdp">



                <TextView
                    android:id="@+id/tv_fav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_favourites"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textSize="@dimen/_11sdp"
                    app:drawableTopCompat="@drawable/add_to_favourites_blank" />
            </RelativeLayout>


            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_77sdp"
                android:layout_weight="0.9"
                android:paddingRight="@dimen/_6sdp"
                android:paddingBottom="@dimen/_14sdp"
                android:paddingLeft="@dimen/_6sdp"
                android:paddingTop="@dimen/_14sdp">

                <View
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="@dimen/_52sdp"
                    android:background="@color/grey_60" />

                <LinearLayout
                    android:id="@+id/ll_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/like"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="5dp"
                        android:paddingLeft="15dp"
                        android:paddingTop="10dp"
                        android:paddingRight="15dp"
                        android:text="@string/like"
                        android:visibility="gone"
                        app:drawableLeftCompat="@drawable/like" />


                    <TextView
                        android:id="@+id/tv_likeimage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_7sdp"
                        android:fontFamily="@font/ubuntu_medium"
                        android:padding="@dimen/_4sdp"
                        android:text="@string/like"
                        app:drawableLeftCompat="@drawable/like_hover" />

                    <TextView
                        android:id="@+id/tv_numberLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_medium"
                        android:padding="@dimen/_4sdp"
                        android:textColor="@color/grey_40"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="@dimen/_52sdp"
                    android:layout_alignParentEnd="true"
                    android:background="@color/grey_60" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rl_share"
                android:layout_width="0dp"
                android:layout_height="@dimen/_77sdp"
                android:layout_weight="0.9"
                android:gravity="center"
                android:padding="@dimen/_14sdp">

                <TextView
                    android:id="@+id/tv_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_11sdp" />
            </RelativeLayout>
        </LinearLayout>


        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_round_corner_green"
            android:backgroundTint="#E6000000"
            android:padding="10dp"
            android:src="@drawable/round_close_24"
            android:layout_alignParentEnd="true"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />


    </RelativeLayout>
</layout>