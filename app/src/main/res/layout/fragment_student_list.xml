<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.app.ecarepro.ui.students_list.StudentListViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.students_list.StudentListFragment">


        <com.google.android.material.appbar.AppBarLayout
            style="@style/Widget.MaterialComponents.AppBarLayout.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:liftOnScroll="true"
            app:liftOnScrollTargetViewId="@id/recycler_view">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navigationIcon="@drawable/ic_arrow_back_24px"
                app:topWindowInsetToPadding="@{true}">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:visibility="visible">


                    <TextView
                        android:id="@+id/tv_heading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/students_list"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        />



                    <ImageView
                        android:id="@+id/img_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:onClick="@{v -> viewModel.showSearchBar()}"
                        android:src="@drawable/round_search_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white"
                        tools:ignore="ContentDescription" />

                    <!--<ImageView
                        android:id="@+id/img_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:onClick="@{v -> viewModel.showSearchBar()}"
                        android:src="@drawable/ic_filter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white"

                        tools:ignore="ContentDescription" />-->

                    <EditText
                        android:id="@+id/search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginEnd="30dp"
                        android:background="@drawable/bg_round_corner_green"
                        android:backgroundTint="@color/white"
                        android:drawableStart="@drawable/round_search_24"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/calibri_regular"
                        android:hint="@string/search"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:text="@={viewModel.searchQuery}"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="LabelFor" />


                    <ImageView
                        android:id="@+id/clearSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:onClick="@{v -> viewModel.clearSearchQuery()}"
                        android:src="@drawable/round_close_24"

                        app:layout_constraintBottom_toBottomOf="@+id/search_bar"
                        app:layout_constraintEnd_toEndOf="@+id/search_bar"
                        app:layout_constraintTop_toTopOf="@+id/search_bar"
                        tools:ignore="ContentDescription" />

                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/groupHeaderView"
                        isVisible="@{!viewModel.showSearchView}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="img_search,tv_heading" />

                    <androidx.constraintlayout.widget.Group
                        android:id="@+id/groupSearchView"
                        isVisible="@{viewModel.showSearchView}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="search_bar,clearSearch" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </com.google.android.material.appbar.MaterialToolbar>


        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_task_list"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_marginHorizontal="10dp"
            android:hint="@string/select_search_filter"
             >

            <AutoCompleteTextView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>


        <RadioGroup
            android:id="@+id/rb_group_school_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:visibility="gone"
            android:layout_marginHorizontal="10dp"
            >

            <RadioButton
                android:id="@+id/rb_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/all"
                android:checked="true"
                />
            <RadioButton
                android:id="@+id/rb_boarding"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="@string/boarding"
                />
            <RadioButton
                android:id="@+id/rb_day_scolar"

                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="@string/day_scholar"
                />


        </RadioGroup>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                 >
                <TextView
                    android:id="@+id/tv_sort_by_admission"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/bg_rounded_corner_green"
                     android:gravity="center"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_7sdp"
                    android:text="@string/admission_number"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/descending" />

                <TextView
                    android:id="@+id/tv_sort_by_roll_no"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_7sdp"
                    android:text="@string/roll_no"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/descending" />

                <TextView
                    android:id="@+id/tv_sort_by_name"
                     android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_7sdp"
                    android:text="@string/name"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/descending" />

                <TextView
                    android:visibility="gone"
                    android:id="@+id/tv_sort_by_class"
                     android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_7sdp"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/descending" />


            </LinearLayout>
        </HorizontalScrollView>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_student_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/student_list_item" />


        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/ubuntu_medium"
            android:gravity="center"

            android:text="@string/no_data"
            android:textSize="16sp"
            android:visibility="gone"

            />


    </LinearLayout>
</layout>