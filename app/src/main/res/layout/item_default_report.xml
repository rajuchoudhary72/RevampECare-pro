<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
         <variable
             name="defaulterData"
             type="com.app.ecarepro.data.network.model.DefaulterDataList" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_5sdp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/round_menu_book_24"
                    app:tint="@color/grey_60"
                    android:contentDescription="@string/admission_no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/admission_no"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tv_addm_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/black"
                    android:text="@{defaulterData.admno}"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/round_person_24"
                    app:tint="@color/grey_60"
                    android:contentDescription="@string/name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/name"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/black"
                    android:text="@{defaulterData.studentname}"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/baseline_school_24"
                    app:tint="@color/grey_60"
                    android:contentDescription="@string/classes" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/classes"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tv_class"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/black"
                    android:text="@{defaulterData.classsection}"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/round_perm_contact_calendar_24"
                    app:tint="@color/grey_60"
                    android:contentDescription="@string/contact_no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/contact_no"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tv_contact_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/black"
                    android:text="@{defaulterData.contactno}"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/round_currency_rupee_24"
                    app:tint="@color/grey_60"
                    android:contentDescription="@string/amount" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/amount"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/black"
                    android:text="@{defaulterData.amount}"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/grey_light" />

    </LinearLayout>
</layout>
