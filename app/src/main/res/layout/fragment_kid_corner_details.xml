<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        tools:context=".ui.gallery.kid_corner.KidCornerFragment">


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:titleCentered="true"
            android:elevation="8dp"
            app:title="Defaulter Report"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:orientation="vertical"
            android:background="@color/white"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_bold"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:text="Created On: "
                    tools:ignore="RtlSymmetry"
                    />

                <TextView
                    android:id="@+id/tv_created_on"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:textColor="@color/light_gray_gallerytext"
                    android:textSize="@dimen/_9sdp"
                    tools:ignore="RtlSymmetry" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_bold"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:text="Updated On :"
                    tools:ignore="RtlSymmetry"
                    />

                <TextView
                    android:id="@+id/tv_updated_on"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:textColor="@color/light_gray_gallerytext"
                    android:textSize="@dimen/_9sdp"
                    tools:ignore="RtlSymmetry" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_bold"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:text="Year Name: "
                    tools:ignore="RtlSymmetry"
                    />

                <TextView
                    android:id="@+id/tv_year"
                    android:layout_width="match_parent"
                    android:layout_height="17dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:textColor="@color/light_gray_gallerytext"
                    android:textSize="@dimen/_9sdp"
                    tools:ignore="RtlSymmetry" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_bold"
                    android:gravity="center_vertical"
                    android:lines="1"
                    android:text="Description: "
                    tools:ignore="RtlSymmetry"
                    />

                <TextView
                    android:id="@+id/tv_des"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/light_gray_gallerytext"
                    android:textSize="@dimen/_9sdp"
                    tools:ignore="RtlSymmetry" />


            </LinearLayout>



        </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_photo_album"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                tools:listitem="@layout/item_kid_corner_item_layout"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                />

            <TextView
                android:id="@+id/tv_no_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_no_item"
                android:fontFamily="@font/ubuntu_medium"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/no_data_found"
                android:textSize="16sp"

                />



    </LinearLayout>
</layout>