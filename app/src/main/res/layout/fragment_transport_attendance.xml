<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.transport_attendance.TransportAttendanceFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_light_primary"
        android:fitsSystemWindows="true">

        <!-- Top Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            android:elevation="8dp"
            app:layout_scrollFlags="noScroll"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Attendance"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white">



            <!-- Right-aligned buttons container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <!-- Departed Count -->
                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:textColor="@color/white"
                    android:text=""
                    android:drawableLeft="@drawable/ic_round_directions_bus_24"
                    />

                <!-- Save Button -->
                <Button
                    android:id="@+id/tv_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:textColor="@color/white"
                    android:text="@string/save"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Collapsible Filter Section -->
        <LinearLayout
            android:id="@+id/ll_toole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_light_primary"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways">

            <!-- Route and Trip Selection Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp">

                <!-- Route Selection -->
                <TextView
                    android:id="@+id/tv_select_route"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_box_des_log"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:text="@string/select_route"
                    android:visibility="visible"
                    app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

                <!-- Trip Selection -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_box_des_log"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/spinner_select_trip"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/_4sdp"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:background="@drawable/spinner_drop_background_white"
                        android:dropDownVerticalOffset="50dp"
                        android:gravity="center_vertical"
                        android:overlapAnchor="true"
                        android:spinnerMode="dropdown"
                        android:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stoppage Selection -->
            <TextView
                android:id="@+id/tv_select_Stoppage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_box_des_log"
                android:fontFamily="@font/ubuntu_light"
                android:gravity="center_vertical"
                android:padding="13dp"
                android:text="@string/select_stoppage"
                android:visibility="visible"
                app:drawableRightCompat="@drawable/ic_dropdown_spinner" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Student List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_student_att_mark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="15dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/transport_att_student_list_item" />

    <!-- No Data Text View (hidden by default) -->
    <TextView
        android:id="@+id/tv_no_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:fontFamily="@font/ubuntu_medium"
        android:gravity="center"
        android:text="@string/no_data_found"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>