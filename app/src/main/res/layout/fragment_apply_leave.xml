<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.leave.apply_leave.ApplyLeaveFragment">





        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:titleCentered="true"
            android:elevation="8dp"
            app:title="Leave Apply"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <LinearLayout
            android:id="@+id/ll_main_leave_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:orientation="vertical"
             >

        <LinearLayout
            android:id="@+id/ll_toole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_light_primary"
            android:gravity="center"
            android:fitsSystemWindows="true"
            android:orientation="vertical"
            app:layout_collapseMode="parallax"
            app:layout_scrollFlags="scroll|enterAlways">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleButton_type_leave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_gravity="center"
                android:gravity="center"
                app:checkedButton="@id/btn_leave_req"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                app:selectionRequired="true"
                app:singleSelection="true"
               android:visibility="gone"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_leave_req"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/leave_request"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"

                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_leave_status"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/general_status"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />


            </com.google.android.material.button.MaterialButtonToggleGroup>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_start_date"
                android:layout_width="0dp"
                android:layout_height="@dimen/cbn_height"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_gravity="center">

                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_from"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/general_from_pun" />


                <TextView
                    android:id="@+id/tv_start_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:ellipsize="end"
                    android:gravity="center"
                     android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="12sp"
                android:layout_height="1.5dp"
                android:layout_gravity="center"
                android:background="@color/grey_60" />

            <LinearLayout
                android:id="@+id/ll_end_date"
                android:layout_width="0dp"
                android:layout_height="@dimen/cbn_height"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_to"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/general_to_pun" />


                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_end_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                     android:layout_gravity="center"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_number_days"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="13dp"
                android:background="@drawable/circle_calender"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:fontFamily="@font/ubuntu_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:padding="9dp"
                android:text="@string/day_s"
                android:textColor="@color/grey_60"
                android:textSize="20sp"
                app:fontFamily="@font/ubuntu_medium" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_margin="12sp"
            android:text="@string/suggested"
            android:textColor="@color/grey_60"
            android:textSize="20sp"
            app:fontFamily="@font/ubuntu_medium" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_marginHorizontal="10dp"
            app:boxStrokeColor="@color/text_input_layout_stroke_color"
            android:layout_marginBottom="10dp" >

            <AutoCompleteTextView
                android:id="@+id/autoCompleteReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="@string/select_reason"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/TextInputLayoutReason"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:visibility="gone"
            android:hint="@string/enter_your_reason"

            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textFiledReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_regular"

                />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layoutProof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/background_box_rectangle_grey"
            android:gravity="center_vertical"
            android:visibility="visible">


            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/attachmentImage"
                        android:layout_width="50dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_centerVertical="true"
                        android:ellipsize="end"
                        android:fontFamily="@font/ubuntu_medium"
                         android:layout_marginStart="10dp"
                         />

                    <ImageView
                        android:id="@+id/image_view_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:visibility="gone"
                        android:src="@drawable/tb_doc_picker_ic_icon_cancel"
                        app:tint="@color/red" />


                </RelativeLayout>


            </FrameLayout>


            <Button
                android:id="@+id/btnAttachment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:fontFamily="@font/ubuntu_bold"
                android:text="@string/select_proof"
                android:textAllCaps="false"
                android:textColor="@color/white" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_leave_tc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i_agree"
                app:fontFamily="@font/ubuntu_medium" />

            <TextView
                android:id="@+id/tv_tc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/terms_and_conditions"
                android:textColor="@color/grey_60"
                app:fontFamily="@font/ubuntu_medium" />
        </LinearLayout>


        <Button
            android:id="@+id/btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply_leave"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            />


        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_leave_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
             >

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_leave_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 tools:listitem="@layout/leave_list_item" />


            <TextView
                android:id="@+id/tv_no_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/ubuntu_medium"
                android:gravity="center"
                android:layout_marginTop="@dimen/_300sdp"
                android:text="@string/no_history_available"
                android:textSize="16sp"
                android:visibility="gone"

                />

        </LinearLayout>




    </LinearLayout>
</layout>