<?xml version="1.0" encoding="utf-8"?>
<layout>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_co"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_light"
    android:orientation="vertical">


    <include
        android:id="@+id/toolbar_serch"
        layout="@layout/custom_toolbar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_serch">


        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@color/brand_color"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/transparent"
            app:tabMinWidth="@dimen/_100sdp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/white"
             />

        <ScrollView
            android:id="@+id/sv_tat_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_50sdp"
            android:background="@color/white"
            android:scrollbars="none">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_120sdp">


                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_270sdp"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:lines="1"
                    />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_270sdp"
                    android:background="@color/white">

                    <RelativeLayout
                        android:id="@+id/rel_test"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:id="@+id/rel_present"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_60sdp"
                            android:background="@color/disabled"
                            android:visibility="gone">

                            <RelativeLayout
                                android:id="@+id/present"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_40sdp"
                                android:layout_margin="@dimen/_10sdp">

                                <TextView
                                    android:id="@+id/text_present"
                                    android:layout_width="@dimen/_35sdp"
                                    android:layout_height="@dimen/_35sdp"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/circle_white"

                                    android:gravity="center"
                                    android:text="@string/p"
                                    android:textAlignment="center"
                                    android:textColor="@color/disabled"
                                    android:textSize="@dimen/_20sdp" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_10sdp"
                                android:layout_toEndOf="@+id/present"
                                android:layout_toRightOf="@+id/present">

                                <TextView
                                    android:id="@+id/text_present_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/present_today"

                                    android:textAlignment="center"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_18sdp" />

                                <TextView
                                    android:id="@+id/text_present2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/text_present_1"
                                    android:gravity="center"
                                    android:visibility="invisible"
                                    android:textAlignment="center"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp" />

                            </RelativeLayout>


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rel_present2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_60sdp"
                            android:background="@color/absent_red"
                            android:visibility="gone">

                            <RelativeLayout
                                android:id="@+id/absent"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_40sdp"
                                android:layout_margin="@dimen/_10sdp">

                                <TextView
                                    android:id="@+id/text_absent"
                                    android:layout_width="@dimen/_35sdp"
                                    android:layout_height="@dimen/_35sdp"
                                    android:layout_centerVertical="true"
                                    android:background="@drawable/circle_white"
                                    android:gravity="center"
                                    android:text="@string/a"
                                    android:textAlignment="center"
                                    android:textColor="@color/absent_red"
                                    android:textSize="@dimen/_20sdp" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_10sdp"
                                android:layout_toRightOf="@+id/absent"
                                android:layout_toEndOf="@+id/absent">

                                <TextView
                                    android:id="@+id/text_absent_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/absent_today"
                                    android:textAlignment="center"
                                    android:textColor="@color/white"

                                    android:textSize="@dimen/_18sdp" />

                                <TextView
                                    android:id="@+id/text_absent2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/text_absent_1"
                                    android:gravity="center"
                                    android:visibility="invisible"
                                    android:textAlignment="center"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/_12sdp" />

                            </RelativeLayout>


                        </RelativeLayout>
                    </RelativeLayout>

                    <include
                        android:id="@+id/fullscreen2"
                        layout="@layout/row_short_attendance_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rel_test"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp" />

                    <LinearLayout
                        android:id="@+id/ll_summry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/fullscreen2"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/from_till_today"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35sdp"
                            android:background="@color/grey_light">

                            <TextView
                                android:id="@+id/from_till_today_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                android:text="@string/from_march"
                                android:textColor="@color/module"
                                android:fontFamily="@font/ubuntu_medium"
                                android:textSize="@dimen/_15sdp" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/from_till_today2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:background="@color/white">

                            <TextView
                                android:id="@+id/school_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:text="@string/total_school_days"
                                android:textColor="@color/module"

                                android:textSize="@dimen/_15sdp" />

                            <TextView
                                android:id="@+id/total_school_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_20sdp"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:textColor="@color/module"
                             
                                android:textSize="@dimen/_15sdp" />


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/from_till_today3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:background="@color/white">

                            <TextView
                                android:id="@+id/present_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                            
                                android:text="@string/total_present"
                                android:textColor="@color/disabled"
                                android:textSize="@dimen/_15sdp" />

                            <TextView
                                android:id="@+id/total_present_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:textColor="@color/disabled"
                                android:textSize="@dimen/_15sdp"
                         
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/_20sdp" />


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/from_till_wh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:background="@color/white">

                            <TextView
                                android:id="@+id/working_present_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:text="Working Holiday"
                                android:textColor="@color/category7"
                                android:textSize="@dimen/_15sdp" />

                            <TextView
                                android:id="@+id/total_working_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:textColor="@color/category7"
                                android:textSize="@dimen/_15sdp"

                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/_20sdp" />


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/from_till_today4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:background="@color/white">

                            <TextView
                                android:id="@+id/absent_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:text="@string/total_absent"
                          
                                android:textColor="@color/absent_red"
                                android:textSize="@dimen/_15sdp" />

                            <TextView
                                android:id="@+id/total_absent_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_20sdp"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:textColor="@color/absent_red"
                         
                                android:textSize="@dimen/_15sdp" />


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/from_till_today_leave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:background="@color/white">

                            <TextView
                                android:id="@+id/leave_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:text="@string/total_leave"
                                android:textColor="@color/att_leave_color"
                                android:textSize="@dimen/_15sdp"
                              
                                android:layout_marginStart="@dimen/_10sdp" />

                            <TextView
                                android:id="@+id/total_leave_day"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:textColor="@color/att_leave_color"
                                android:textSize="@dimen/_15sdp"
                                android:layout_alignParentEnd="true"
                                
                                android:layout_marginEnd="@dimen/_20sdp" />


                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rl_late_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_20sdp"
                            android:background="@color/white"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentLeft="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                
                                android:text="@string/total_late_days"
                                android:textColor="@color/att_late_color"
                                android:textSize="@dimen/_15sdp" />

                            <TextView
                                android:id="@+id/tv_late_month_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                
                                android:layout_marginEnd="@dimen/_20sdp"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:textColor="@color/att_late_color"
                                android:textSize="@dimen/_15sdp" />


                        </RelativeLayout>
                        <include layout="@layout/row_attendance_circle"
                            android:id="@+id/incRowAttendanceCircle"/>
                    </LinearLayout>



                </RelativeLayout>

            </RelativeLayout>
        </ScrollView>

    </RelativeLayout>




</RelativeLayout>
</layout>