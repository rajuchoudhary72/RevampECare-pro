<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="15dp">

    <TextView
        android:id="@+id/tv_browse_photo"
        android:layout_width="0dp"
        android:layout_weight="0.8"
        android:layout_height="wrap_content"
        android:drawablePadding="3dp"
        android:fontFamily="@font/ubuntu_medium"
        android:padding="5dp"
        android:text="@string/attach_image"
        app:drawableTopCompat="@drawable/ic_camera"
        android:layout_marginVertical="@dimen/_25sdp"
        android:gravity="bottom|center" />

    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@color/grey_light"
        android:layout_marginVertical="3dp" />

    <TextView
        android:layout_weight="1"
        android:id="@+id/tv_browse_file"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="3dp"
        android:fontFamily="@font/ubuntu_medium"
        android:padding="5dp"
        android:text="@string/attach_pdf"
        android:layout_marginVertical="@dimen/_25sdp"
        app:drawableTopCompat="@drawable/ic_add_account"
        android:gravity="bottom|center" />
</LinearLayout>
