<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="card"
            type="com.app.ecarepro.data.network.model.Card" />

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_dashboard_card"
        cardBgColor="@{card.color}"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:onClick="@{clickListener}"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
        tools:cardBackgroundColor="@color/green">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:minLines="2"
                android:maxLines="2"
                android:id="@+id/label_total_student"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:text="@{card.heading}"
                android:textSize="8sp"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                app:layout_constraintEnd_toStartOf="@+id/image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Total Student" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/txt_total_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{card.data}"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@+id/label_total_student"
                app:layout_constraintTop_toBottomOf="@+id/label_total_student"
                tools:text="5475" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_total_student" />


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image"
                imageUrl="@{card.iconUrl}"
                app:contentPadding="@dimen/_2sdp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:backgroundTint="@color/green"
                android:background="@color/green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/label_total_student"
                app:layout_constraintBottom_toBottomOf="@+id/txt_total_student"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ECarePro.ImageView.Circle"
                app:strokeColor="@color/white"
                app:strokeWidth=".5dp"
                tools:ignore="ContentDescription"
                tools:src="@drawable/img_student" />


            <TextView
                android:includeFontPadding="false"
                android:id="@+id/txt_boys_count"
                isInvisible="@{card.data1 == null}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginBottom="8dp"
                android:textSize="8dp"
                android:minLines="2"
                android:maxLines="2"
                android:text="@{card.data1}"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txt_girls_count"
                app:layout_constraintStart_toStartOf="@+id/label_total_student"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                tools:text="Boys : 741" />

            <TextView
                android:includeFontPadding="false"
                android:id="@+id/txt_girls_count"
                isInvisible="@{card.data1 == null}"
                android:layout_width="0dp"
                android:minLines="2"
                android:maxLines="2"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="8dp"
                android:layout_marginEnd="8dp"
                android:text="@{card.data2}"
                android:textColor="@color/black"
                app:layout_constraintBaseline_toBaselineOf="@+id/txt_boys_count"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txt_boys_count"
                tools:text="Girls : 741" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>