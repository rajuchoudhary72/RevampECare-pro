<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="lessonData"
            type="com.app.ecarepro.model.LessonPlan" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.lessonPlan.view.ViewLessonPlanFragment">


        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:titleCentered="true"
            android:elevation="8dp"
            app:title="Lesson Details"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/topic"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tvTopic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"

                            android:text="@{lessonData.topic}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/plan_duration"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_plan_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                             android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/subject"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_subject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.subject}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/classes"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_class"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.classesName}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/status"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tv_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ubuntu_medium"
                                 android:textColor="@color/grey_40"
                                android:textSize="@dimen/_12sdp" />
                            <TextView
                                android:id="@+id/tv_status_by"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ubuntu_medium"
                                 android:textColor="@color/grey_40"
                                android:textSize="@dimen/_12sdp" />

                        </LinearLayout>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/comments"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_comment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.rejectionComments}"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_12sdp" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/objective"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tvObj"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.objective}"

                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/resources"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_resource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.resources}"

                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/auditory"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_audi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.auditoryTxt}"

                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/visual_youtube_link"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_you_link"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.youtubeLinks}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/kinesthetic_activity"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_K_A"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.kinestheticActivity}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/otherresources_activity"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_oter_res_act"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.otherResources}"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/otherresources_verbal"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_oter_res_ver"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.extensionTopic}"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_12sdp" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="30dp"
                        android:padding="10dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/introduction"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tvIntro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"

                            android:text="@{lessonData.introduction}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/closure"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_closure"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.closure}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/learning_outcomes_others"

                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_plan_lea_out_others"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@{lessonData.learningOutcomes}"
                            android:textColor="@color/grey_40"
                            android:textSize="@dimen/_12sdp" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_4sdp" />



                        <LinearLayout
                            android:id="@+id/llFile"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_35sdp"
                            android:layout_gravity="center_vertical"
                             android:layout_marginTop="10dp"
                            android:background="@drawable/rectangle_border_gray_corner_radius"
                            android:gravity="center_vertical"
                            android:padding="@dimen/_5sdp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/tv_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:ellipsize="end"
                                android:fontFamily="@font/ubuntu_medium"
                                android:lines="1"
                                android:paddingStart="@dimen/_5sdp"
                                android:paddingEnd="@dimen/_5sdp"
                                android:text="@string/attachment"
                                android:textColor="#545454"
                                android:textSize="@dimen/_10sdp" />

                            <ImageView
                                android:id="@+id/ivFileView"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:visibility="visible"
                                android:src="@drawable/download_fill" />

                        </LinearLayout>



                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_details_approve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/_30sdp"

                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >

                        <LinearLayout
                            android:id="@+id/ll_check"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/cb_open_student"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:fontFamily="@font/ubuntu_medium" />

                            <TextView
                                android:id="@+id/tv_tc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingEnd="@dimen/_4sdp"
                                android:paddingLeft="@dimen/_4sdp"
                                android:paddingRight="@dimen/_4sdp"
                                android:paddingStart="@dimen/_4sdp"
                                android:text="Enable for the students after approval"
                                app:fontFamily="@font/ubuntu_medium" />
                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/llAction"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sdp"
                            android:layout_margin="@dimen/_5sdp"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/tvApprove"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_weight="1"
                                android:background="@drawable/background_box_rectangle_black"
                                android:gravity="center"
                                android:paddingTop="@dimen/_10sdp"
                                android:paddingBottom="@dimen/_10sdp"
                                android:text="Approve"
                                android:textColor="@color/green"
                                android:textSize="@dimen/_16sdp"
                                app:fontFamily="@font/ubuntu_bold" />

                            <View
                                android:layout_width="@dimen/_2sdp"
                                android:layout_height="match_parent"
                                android:background="@color/transparent"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/tvReject"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_weight="1"
                                android:background="@drawable/background_box_rectangle_black"
                                android:gravity="center"
                                android:paddingTop="@dimen/_10sdp"
                                android:paddingBottom="@dimen/_10sdp"
                                android:text="Reject"
                                android:textColor="@color/red"
                                android:textSize="@dimen/_16sdp"
                                app:fontFamily="@font/ubuntu_bold" />

                        </LinearLayout>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>





    </LinearLayout>
</layout>