<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_main"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_7sdp"
            android:layout_marginTop="@dimen/_7sdp"
            app:cardCornerRadius="@dimen/_7sdp"
            app:elevation="@dimen/_7sdp">

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_photo"
                    android:layout_width="@dimen/_130sdp"
                    android:layout_height="@dimen/_130sdp"
                    android:contentDescription="@string/gallery"
                    android:scaleType="centerCrop" />
                <!--app:srcCompat="@drawable/no_photo" />-->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_marginEnd="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:fontFamily="@font/ubuntu_medium"
                        android:lines="2"
                        android:gravity="center_vertical"
                        android:textColor="@color/blue_headline"
                        android:textSize="@dimen/_12sdp" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:text="@string/general_newspaper_pun"
                        android:textColor="@color/blue_headline"
                        android:textSize="@dimen/_9sdp"
                        tools:ignore="RtlSymmetry" />

                    <TextView
                        android:id="@+id/tv_newspaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:text="@string/news_paper"
                        android:textColor="@color/light_gray_gallerytext"
                        android:textSize="@dimen/_9sdp"
                        tools:ignore="RtlSymmetry" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:text="@string/published_on"
                        android:textColor="@color/blue_headline"
                        android:textSize="@dimen/_9sdp"
                        tools:ignore="RtlSymmetry" />

                    <TextView
                        android:id="@+id/tv_publi_on"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:text="@string/_35_34_4444"
                        android:textColor="@color/light_gray_gallerytext"
                        android:textSize="@dimen/_9sdp"
                        tools:ignore="RtlSymmetry" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:text="@string/updated_on"
                        android:textColor="@color/blue_headline"
                        android:textSize="@dimen/_9sdp"
                        tools:ignore="RtlSymmetry" />


                    <TextView
                        android:id="@+id/tv_updted_on"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:lines="1"
                        android:text="@string/_34_344_3444"
                        android:textColor="@color/light_gray_gallerytext"
                        android:textSize="@dimen/_9sdp"
                        tools:ignore="RtlSymmetry" />


                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</layout>