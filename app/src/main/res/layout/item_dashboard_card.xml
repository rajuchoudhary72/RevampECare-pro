<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/category7"
        app:cardCornerRadius="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_drag"
                android:background="#37000000"
                android:paddingHorizontal="10dp"
                android:src="@drawable/ic_drag"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="0dp"/>

            <TextView
                android:id="@+id/label_total_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:drawablePadding="8dp"
                android:text="Total Student"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnPrimary"
                app:drawableStartCompat="@drawable/ic_multi_user"
                app:layout_constraintStart_toEndOf="@+id/img_drag"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_total_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:text="5475"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintStart_toStartOf="@+id/label_total_student"
                app:layout_constraintTop_toBottomOf="@+id/label_total_student" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="0dp"
                app:layout_constraintStart_toStartOf="@+id/label_total_student"
                app:layout_constraintEnd_toEndOf="@id/image"
                android:layout_marginTop="-10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toBottomOf="@+id/image"
                android:layout_height="wrap_content"/>


            <ImageView
                android:id="@+id/image"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/img_student"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="ContentDescription" />


            <TextView
                android:id="@+id/txt_boys_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:text="Boys : 741"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintStart_toStartOf="@+id/label_total_student"
                app:layout_constraintTop_toBottomOf="@+id/image" />

            <TextView
                android:id="@+id/txt_girls_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:text="Girls : 741"
                android:textColor="?attr/colorOnPrimary"
                app:layout_constraintEnd_toEndOf="@id/image"
                app:layout_constraintBaseline_toBaselineOf="@+id/txt_boys_count" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>