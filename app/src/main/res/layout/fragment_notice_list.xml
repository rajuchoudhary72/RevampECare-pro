<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="mnoticeViewModel"
            type="com.app.ecarepro.ui.notice.NoticeViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.notice.NoticeListFragment">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_notice_list"
            style="@style/Widget.MaterialComponents.AppBarLayout.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:liftOnScroll="true"
            topWindowInsetToPadding="@{true}">

            <com.google.android.material.appbar.MaterialToolbar
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="All Notices(14/52)"
                app:titleTextAppearance="?attr/titleTextAppearance"
                app:navigationIcon="@drawable/ic_arrow_back_24px"
                app:titleTextColor="@color/white"
                app:titleCentered="true">

            </com.google.android.material.appbar.MaterialToolbar>


        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            app:layout_constraintTop_toBottomOf="@+id/appbar_notice_list"
            android:id="@+id/ll_toole"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_light_primary"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleButton_type_noti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_gravity="center"
                android:gravity="center"
                app:checkedButton="@id/btn_mobile"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_noti"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/notice"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    android:backgroundTint="@color/white"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_class_noti"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/class_notice"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />


            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Spinner
                android:id="@+id/spinnerClass"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/spinner_background"
                android:spinnerMode="dropdown"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"

                />


        </LinearLayout>


        <com.airbnb.epoxy.EpoxyRecyclerView
            android:id="@+id/recycler_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/ll_toole"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            tools:listitem="@layout/notice_list_item" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>