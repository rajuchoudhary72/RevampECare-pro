<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="mnoticeViewModel"
            type="com.app.ecarepro.ui.notice.NoticeViewModel" />

    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".ui.notice.NoticeListFragment">


        <LinearLayout
            android:id="@+id/ll_toole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fitsSystemWindows="true"
            android:orientation="vertical"
           >

            <include
                android:id="@+id/include_toolbar"
                layout="@layout/common_toolbar"
                />


            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleButton_type_noti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_gravity="center"
                android:gravity="center"
                app:checkedButton="@id/btn_noti"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                android:visibility="gone"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_noti"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/notice"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"

                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_class_noti"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/class_notice"
                    app:strokeColor="@color/white"
                    app:rippleColor="@color/white"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerExtraSmall" />


            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/autoInputClassInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_marginHorizontal="10dp"
                android:visibility="gone"
                app:boxStrokeColor="@color/text_input_layout_stroke_color"
                android:layout_marginBottom="10dp"

                >

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="@string/select_class"
                    />

            </com.google.android.material.textfield.TextInputLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_notice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
                tools:listitem="@layout/notice_list_item"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

                />



        </LinearLayout>

        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:fontFamily="@font/ubuntu_medium"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/no_notice_available"
            android:textSize="16sp"

            />



    </RelativeLayout>
</layout>