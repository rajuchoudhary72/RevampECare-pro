<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="isExpanded"
            type="java.lang.Boolean" />

    </data>

    <soup.neumorphism.NeumorphCardView
        android:id="@+id/Button1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:neumorph_backgroundColor="@color/background_dashboard"
        app:neumorph_lightSource="leftTop"
        app:neumorph_shapeAppearance="@style/CustomShapeAppearanceButton"
        app:neumorph_strokeWidth="@dimen/_1sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:animateLayoutChanges="true">


            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:fontFamily="@font/ubuntu_medium"
                android:gravity="center_vertical"
                android:text="@string/activity_calender"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/calenderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/ubuntu_bold"
                android:gravity="center_vertical"
                android:text="@string/oct"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnPreviewMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_12sdp"
                android:background="@color/green_20"
                android:rotation="180"
                android:src="@drawable/ic_arrow_right_black"
                app:contentPadding="@dimen/_4sdp"
                app:layout_constraintBottom_toBottomOf="@+id/calenderTitle"
                app:layout_constraintEnd_toStartOf="@+id/btnNextMonth"
                app:layout_constraintTop_toTopOf="@+id/calenderTitle"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceMediumComponent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnNextMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/green_20"
                android:src="@drawable/ic_arrow_right_black"
                app:contentPadding="@dimen/_4sdp"
                app:layout_constraintBottom_toBottomOf="@+id/calenderTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/calenderTitle"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceMediumComponent" />

            <com.kizitonwose.calendar.view.CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                app:cv_dayViewResource="@layout/item_calendar_day"
                app:cv_monthHeaderResource="@layout/calendar_header"
                app:layout_constraintTop_toBottomOf="@+id/calenderTitle" />


            <TextView
                android:id="@+id/selectedDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/grey_10"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:textAllCaps="true"
                android:textColor="@color/blue_headline"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/calendarView"
                tools:text="7 Jan, 2019" />

            <com.airbnb.epoxy.EpoxyRecyclerView
                android:id="@+id/eventsView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/selectedDateText" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </soup.neumorphism.NeumorphCardView>


</layout>