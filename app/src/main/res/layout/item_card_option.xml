<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.app.ecarepro.data.network.model.Menu" />

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

    </data>

    <LinearLayout
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_width="90dp"
        android:layout_height="@dimen/_100sdp"
        android:onClick="@{clickListener}"
        android:orientation="vertical"
         android:gravity="center"
         >


        <soup.neumorphism.NeumorphCardView
            android:id="@+id/Button1"
             android:layout_width="85dp"
             android:layout_height="85dp"
            app:neumorph_lightSource="leftTop"
            app:neumorph_shapeAppearance="@style/CustomShapeAppearanceButton"

            app:neumorph_backgroundColor="@color/background_dashboard"
             app:neumorph_strokeWidth="@dimen/_1sdp"
            >

            <ImageView
                android:id="@+id/image"
                imageUrl="@{data.icon}"
                placeholder="@{@drawable/img_school_placeholder}"
                android:layout_width="25dp"
                app:tint="@color/md_theme_light_primary"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                />


        </soup.neumorphism.NeumorphCardView>


            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="5dp"
                 android:text="@{data.title}"
                android:textStyle="bold"
                 android:gravity="center"
                android:textSize="12sp"

                android:layout_gravity="center"
                tools:text="Assignments " />


    </LinearLayout>

</layout>