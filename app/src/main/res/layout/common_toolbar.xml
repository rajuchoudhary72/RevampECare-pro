<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="toolbarViewModel"
            type="com.app.ecarepro.ui.common.CommonToolbarViewModel" />

    </data>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_color"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:topWindowInsetToPadding="@{true}">

            <RelativeLayout
                android:id="@+id/rl_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                >




                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    >
                    <ImageButton
                        android:id="@+id/ib_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        app:tint="@color/white"
                        android:padding="8dp"
                        android:backgroundTint="@color/transparent"
                        android:visibility="gone"
                        />
                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/general_save"
                        android:layout_gravity="end"
                        android:visibility="gone"
                        />

                </LinearLayout>

            </RelativeLayout>
        </com.google.android.material.appbar.MaterialToolbar>


        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            android:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/img_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:onClick="@{v -> toolbarViewModel.showSearchBar()}"
                android:src="@drawable/round_search_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white"
                tools:ignore="ContentDescription"
                android:visibility="gone"
                />

            <EditText
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_round_corner_green"
                android:backgroundTint="@color/white"
                android:drawableStart="@drawable/round_search_24"
                android:drawablePadding="10dp"
                android:fontFamily="@font/calibri_regular"
                android:hint="@string/search"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:text="@={toolbarViewModel.searchQuery}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="LabelFor" />

            <ImageView
                android:id="@+id/clearSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="?selectableItemBackgroundBorderless"
                android:onClick="@{v -> toolbarViewModel.clearSearchQuery()}"
                android:src="@drawable/round_close_24"
                app:layout_constraintBottom_toBottomOf="@+id/search_bar"
                app:layout_constraintEnd_toEndOf="@+id/search_bar"
                app:layout_constraintTop_toTopOf="@+id/search_bar"
                tools:ignore="ContentDescription" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupHeaderView"
                isVisible="@{!toolbarViewModel.showSearchView}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="img_search"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupSearchView"
                isVisible="@{toolbarViewModel.showSearchView}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="search_bar,clearSearch"
                android:visibility="gone" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </FrameLayout>



</layout>
