<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="studentData"
            type="com.app.ecarepro.model.StudentDTL" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.discipline_log.infraction.add_infraction.AddInfractionFragment">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            app:layout_collapseMode="pin"
             app:titleCentered="true"
            android:elevation="8dp"
            app:title="Add Infrection"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            android:theme="@style/MyThemeOverlay_Toolbar"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white"
             />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:id="@+id/lin_pro"
                    android:layout_width="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:visibility="visible"
                    android:background="@color/white"
                    android:paddingVertical="13dp"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center">


                        <RelativeLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/profile_image_circuler_bg">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/circleImageViewProfile"
                                imageUrl="@{studentData.photo}"
                                placeholder="@{@drawable/default_profile}"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_centerInParent="true"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ECarePro.ImageView.Circle" />


                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/tv_student_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ubuntu_light"
                                    android:text="@{studentData.name}"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/tv_admission_no"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ubuntu_light"
                                     />

                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/rel_dob"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/tv_class_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ubuntu_light"
                                     />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/tv_father_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ubuntu_light"
                                     />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginVertical="5dp"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/tv_contact"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ubuntu_light"
                                     />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/LL_add_infraction"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/tv_select_infraction_cate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/edit_text_box_des_log"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:padding="13dp"
                        android:layout_marginVertical="5dp"
                        android:text="@string/select_infraction_category"
                        android:visibility="visible"
                        app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


                    <TextView
                        android:id="@+id/tv_select_sub_infraction"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="5dp"
                        android:background="@drawable/edit_text_box_des_log"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:padding="13dp"
                        android:text="@string/select_infraction_subcategory"
                        android:visibility="visible"
                        app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_instance"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="10dp"
                            android:background="@drawable/edit_text_box_des_log"
                            android:fontFamily="@font/ubuntu_light"
                            android:gravity="center_vertical"
                            android:padding="13dp"
                            android:layout_marginVertical="5dp"
                            android:text="@string/instance"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/tv_select_cons"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="10dp"
                            android:background="@drawable/edit_text_box_des_log"
                            android:fontFamily="@font/ubuntu_light"
                            android:gravity="center_vertical"
                            android:padding="13dp"
                            android:layout_marginVertical="5dp"
                            android:text="@string/select_consequences"
                            android:visibility="visible"
                            app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


                    </LinearLayout>


                    <EditText
                        android:id="@+id/et_plan_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="5dp"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/edit_text_box_des_log"
                        android:fontFamily="@font/ubuntu_light"
                        android:hint="@string/enter_corrective_action"
                        android:visibility="visible" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginTop="45dp"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/tv_continue_noti"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginVertical="10dp"
                            android:paddingHorizontal="10dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="@color/brand_color"
                            app:cardCornerRadius="8dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:layout_marginHorizontal="10sp"
                                    android:fontFamily="@font/ubuntu_light"
                                    android:gravity="center_vertical"
                                    android:padding="3dp"
                                    android:text="@string/save_amp_notify"
                                    android:textColor="@color/white"
                                    android:visibility="visible" />
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:id="@+id/tv_continue"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="10dp"
                            app:cardBackgroundColor="@color/brand_color"
                            app:cardCornerRadius="8dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_centerInParent="true"
                                    android:layout_gravity="center"
                                    android:layout_marginHorizontal="10dp"
                                    android:fontFamily="@font/ubuntu_light"
                                    android:gravity="center_vertical"
                                    android:padding="3dp"
                                    android:text="@string/save"
                                    android:textColor="@color/white"
                                    android:visibility="visible" />
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>


                    </LinearLayout>


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/ubuntu_italic"
                        android:gravity="center"
                        android:text="@string/lbl_message_create_new_inferaction"
                        android:textColor="#545454"
                        android:textSize="12sp"
                        android:layout_marginBottom="70dp"
                        android:layout_marginHorizontal="35dp" />

                </LinearLayout>


            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>