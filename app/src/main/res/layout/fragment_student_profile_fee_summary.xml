<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.studentProfile.StudentProfileFeeSummaryFragment">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/llSelectYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/academic_year"
                    android:visibility="gone"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/ctvSelectYear"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/background_box_rectangle_white_round"
                    android:drawablePadding="@dimen/_10sdp"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:paddingRight="@dimen/_10sdp"
                    android:text="@string/select_year"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_14sdp"
                    android:visibility="visible"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

                <TextView
                    android:id="@+id/tvAllPaidHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/rounded_bg_appcolor_button"
                    android:fontFamily="@font/ubuntu_medium"
                    android:paddingLeft="@dimen/_7sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingRight="@dimen/_7sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="@string/view_paid_transaction"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    android:textSize="@dimen/_12sdp" />
            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rl_main"
                android:layout_below="@+id/llSelectYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



            <LinearLayout
                android:id="@+id/llHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:layout_margin="@dimen/_2sdp"
                android:background="@color/grey_light"
                android:paddingTop="@dimen/_5sdp"
                android:visibility="visible"
                android:paddingBottom="@dimen/_5sdp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/installment"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/actual_fee"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/concession"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/received"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/outstanding"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeePaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:layout_below="@+id/llHeading" />

            <LinearLayout
                android:id="@+id/llTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rvFeePaid"
                android:layout_marginLeft="@dimen/_2sdp"
                android:layout_marginRight="@dimen/_2sdp"
                android:background="@color/grey_light"
                android:paddingTop="@dimen/_5sdp"
                android:visibility="visible"
                android:paddingBottom="@dimen/_5sdp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:text="@string/total"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tvTotalFee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tvTotalConcession"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tvTotalReceived"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tvTotalOutstanding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:fontFamily="@font/ubuntu_medium"
                    android:gravity="center"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_11sdp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdvanceAmt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/grey_60"
                android:layout_below="@+id/llTotal"
                android:visibility="gone"
                android:fontFamily="@font/ubuntu_medium" />

            <LinearLayout
                android:id="@+id/llPieChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvAdvanceAmt"
                android:visibility="visible"
                android:layout_margin="@dimen/_5sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    >
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_200sdp"
                        />

                    <com.github.aachartmodel.aainfographics.aachartcreator.AAChartView
                        android:id="@+id/pieChartView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_200sdp"
                        android:visibility="gone"
                         />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="@dimen/_8sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:layout_gravity="center"
                            android:background="@color/green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_1sdp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/received"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_10sdp" />

                        <TextView
                            android:id="@+id/tvReceivedPer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_2sdp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp">

                        <View
                            android:layout_width="@dimen/_8sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:layout_gravity="center"
                            android:background="@color/red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_1sdp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/outstanding"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_10sdp" />

                        <TextView
                            android:id="@+id/tvOutstandingPer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_1sdp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp">

                        <View
                            android:layout_width="@dimen/_8sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:layout_gravity="center"
                            android:background="@color/att_na_color" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_1sdp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:text="@string/concession"
                            android:textColor="@color/grey_60"
                            android:textSize="@dimen/_10sdp" />

                        <TextView
                            android:id="@+id/tvConcessionPer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_2sdp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textColor="@color/grey_60"

                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/llPieChart" />


        </RelativeLayout>


            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/no_record_found"
               android:layout_centerInParent="true"
                android:visibility="gone"
                 android:gravity="center"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/red"
                android:layout_marginTop="@dimen/_100sdp"
                android:layout_centerHorizontal="true" />



        </RelativeLayout>


    </ScrollView>
</layout>