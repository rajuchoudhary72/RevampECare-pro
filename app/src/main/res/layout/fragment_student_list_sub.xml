<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.app.ecarepro.ui.students_list.StudentListViewModel" />

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.students_list.students_new_list.StudentListSubFragment">

        <LinearLayout
     android:id="@+id/ll_total_count"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
            android:paddingVertical="@dimen/_5sdp"
            android:background="@color/white"
            >

            <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
                android:gravity="center"

         >

        <TextView
            android:id="@+id/tv_total_student_text_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            app:drawableLeftCompat="@drawable/ic_total_student"
            android:fontFamily="@font/ubuntu_regular"
            android:drawablePadding="@dimen/_2sdp"
            android:text="@string/total_student_s"
            />

        <TextView
            android:id="@+id/tv_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="55"
            android:layout_marginStart="@dimen/_2sdp"
            android:fontFamily="@font/ubuntu_regular"
            tools:ignore="ObsoleteLayoutParam" />

        <LinearLayout
            android:id="@+id/ll_total_boys_girls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                >

                <TextView
                    android:id="@+id/tv_boys_Count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="@string/boys"
                    android:layout_gravity="center"
                    android:gravity="center"
                    app:drawableLeftCompat="@drawable/account_circle_24dp"
                    android:fontFamily="@font/ubuntu_regular"
                    android:drawablePadding="@dimen/_2sdp"
                    />

                <TextView
                    android:id="@+id/tv_boys_Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="35"
                    android:layout_marginStart="@dimen/_2sdp"
                     />




                <TextView
                    android:id="@+id/tv_girls_Count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="@string/girls"
                    android:layout_gravity="center"
                    android:gravity="center"
                    app:drawableLeftCompat="@drawable/account_circle_24dp_fill"
                    android:drawablePadding="@dimen/_2sdp"
                    />

                <TextView
                    android:id="@+id/tv_girls_Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:fontFamily="@font/ubuntu_regular"
                    android:text="35"
                    />

            </LinearLayout>


        </LinearLayout>


    </LinearLayout>



 </LinearLayout>



         <com.google.android.material.divider.MaterialDivider
             android:id="@+id/divider_one"
             android:layout_width="match_parent"
             android:layout_height="2dp"
             android:layout_below="@+id/ll_total_count"
             />

        <HorizontalScrollView
            android:id="@+id/horizontal_scroll_view_sort_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
             android:layout_below="@+id/divider_one"
            android:background="@color/white"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:gravity="center"
                >

                <TextView
                    android:id="@+id/tv_sort_by_roll_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/grey_10"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="@string/roll_no"
                    android:textColor="@color/black"
                    app:drawableStartCompat="@drawable/descending" />


                <TextView
                    android:id="@+id/tv_sort_by_admission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/grey_10"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:gravity="center"
                    android:text="@string/admission_number"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:textColor="@color/black"
                    app:drawableStartCompat="@drawable/descending" />

                <TextView
                    android:id="@+id/tv_sort_by_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/grey_10"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:text="@string/name"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/descending" />

                <TextView
                    android:visibility="gone"
                    android:id="@+id/tv_sort_by_class"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/bg_rounded_corner_green"
                    android:fontFamily="@font/calibri_regular"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_7sdp"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/descending" />


            </LinearLayout>
        </HorizontalScrollView>
        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider_two"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_below="@+id/horizontal_scroll_view_sort_by"

             />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_student_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/divider_two"
            android:layout_marginBottom="100dp"
            tools:listitem="@layout/student_list_item" />


        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/ubuntu_medium"
            android:gravity="center"
            android:layout_centerInParent="true"
            android:text="@string/no_data"
            android:textSize="16sp"
            android:visibility="gone"

            />

        <RelativeLayout
            android:id="@+id/rl_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="100dp"
             android:layout_alignParentBottom="true"
            android:background="@drawable/bottom_nav_background"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <RelativeLayout
                    android:id="@+id/rl_main_search"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="@dimen/_30sdp"
                     android:layout_marginTop="25dp"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:visibility="visible">





                        <ImageView
                            android:id="@+id/img_search"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:onClick="@{v -> viewModel.showSearchBar()}"
                            android:src="@drawable/round_search_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/white"
                            tools:ignore="ContentDescription" />

                        <!--<ImageView
                            android:id="@+id/img_filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:onClick="@{v -> viewModel.showSearchBar()}"
                            android:src="@drawable/ic_filter"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/white"

                            tools:ignore="ContentDescription" />-->

                        <EditText
                            android:id="@+id/search_bar"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                             android:background="@drawable/bg_round_corner_green"
                            android:backgroundTint="@color/white"
                            android:drawableTint="@color/grey_60"
                            android:drawableStart="@drawable/round_search_24"
                            android:drawablePadding="@dimen/_10sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/calibri_regular"
                            android:hint="@string/search_by_name_class_section_roll_no_father_name"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:paddingStart="@dimen/_15sdp"
                            android:paddingEnd="@dimen/_50sdp"
                            android:text="@={viewModel.searchQuery}"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:ignore="LabelFor" />


                        <ImageView
                            android:id="@+id/clearSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:onClick="@{v -> viewModel.clearSearchQuery()}"
                            android:src="@drawable/round_close_24"

                            app:layout_constraintBottom_toBottomOf="@+id/search_bar"
                            app:layout_constraintEnd_toEndOf="@+id/search_bar"
                            app:layout_constraintTop_toTopOf="@+id/search_bar"
                            app:tint="@color/grey_60"
                            tools:ignore="ContentDescription" />

                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/groupHeaderView"
                            isVisible="@{!viewModel.showSearchView}"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="img_search" />

                        <androidx.constraintlayout.widget.Group
                            android:id="@+id/groupSearchView"
                            isVisible="@{viewModel.showSearchView}"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                             />


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </RelativeLayout>



            </LinearLayout>


        </RelativeLayout>


    </RelativeLayout>
</layout>