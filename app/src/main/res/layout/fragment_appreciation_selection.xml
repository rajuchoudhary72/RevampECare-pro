<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
         tools:context=".ui.discipline_log.infraction.appreciation.AppreciationSelectionFragment">


        <TextView
            android:id="@+id/tv_view_appreciation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:textColor="@color/grey_80"
            android:textSize="21sp"
            android:layout_margin="20dp"
            app:drawableTopCompat="@drawable/view_appreciation"
            android:text="@string/view_appreciation"
            app:fontFamily="@font/ubuntu_medium" />

        <TextView
            android:id="@+id/tv_add_appreciation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:textSize="21sp"
            android:textColor="@color/grey_80"
            android:text="@string/add_appreciation"
            android:layout_margin="20dp"
            app:drawableTopCompat="@drawable/add_appreciation"
            app:fontFamily="@font/ubuntu_medium" />


    </LinearLayout>
</layout>