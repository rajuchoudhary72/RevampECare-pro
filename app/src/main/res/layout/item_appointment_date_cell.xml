<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="filedName"
            type="java.lang.String" />

        <variable
            name="hintText"
            type="java.lang.String" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/filedNameDate"
            android:layout_width="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/date"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/avd_profile"
            android:drawablePadding="5dp"
            android:fontFamily="@font/calibri_regular"
            android:gravity="center_vertical"
            android:text="@{filedName}"
            tools:text="User Name" />

        <TextView
            android:id="@+id/filedNameTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/avd_profile"
            android:drawablePadding="5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/time"
            android:fontFamily="@font/calibri_regular"
            android:gravity="center_vertical"
            android:text="@{filedName}"
            tools:text="User Name" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/asterick"
            app:layout_constraintStart_toEndOf="@id/filedNameDate"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/red" />
        <ImageView
            android:layout_width="10dp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/asterick"
            app:layout_constraintStart_toEndOf="@id/filedNameTime"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/red" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/date"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginEnd="@dimen/_10sdp"
            android:hint="@{hintText}"
            app:hintTextColor="@color/grey_40"
            app:layout_constraintEnd_toStartOf="@+id/time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/filedNameDate"
            app:shapeAppearanceOverlay="?shapeAppearanceCornerSmall"
            tools:hint="@string/enter_user_name">

            <AutoCompleteTextView
                android:id="@+id/textDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/time"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@{hintText}"
            app:hintTextColor="@color/grey_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/date"
            app:layout_constraintTop_toBottomOf="@+id/filedNameTime"
            app:shapeAppearanceOverlay="?shapeAppearanceCornerSmall"
            tools:hint="@string/enter_user_name">

            <AutoCompleteTextView
                android:id="@+id/textTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>