<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/sc_parent_layout"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="pickImage" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_light_primary"
            android:elevation="8dp"
            app:layout_collapseMode="pin"
            app:navigationIcon="@drawable/ic_arrow_back_24px"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Student ID"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/titleTextAppearance"
            app:titleTextColor="@color/white" >
        </com.google.android.material.appbar.MaterialToolbar>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_parent_student_id"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">


                <FrameLayout
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/profile_image_circuler_bg">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/circleImageViewProfile"
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="@dimen/_70sdp"
                        android:src="@drawable/ic_no_profile_big"
                        app:civ_border_color="@color/white"
                        android:layout_gravity="center"
                        app:civ_border_width="@dimen/_2sdp"
                        app:srcCompat="@drawable/ic_no_profile_big" />


                </FrameLayout>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_15sdp">

                    <TextView
                        android:id="@+id/tv_class"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:fontFamily="@font/ubuntu_light"
                        android:textColor="@color/module"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_roll_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/_15sdp"
                        android:fontFamily="@font/ubuntu_light"
                        android:textColor="@color/module"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                </RelativeLayout>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardCornerRadius="@dimen/_15sdp"
                    app:cardBackgroundColor="#E4FCE6"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_marginVertical="@dimen/_15sdp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/general_name_pun"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/general_father_name_pun"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_father_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/father_mobile"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_father_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/mother_name"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_mother_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/mother_mobile"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_mother_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/birth_date"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_dob"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/blood_group_pun"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/aadhar_card_no"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_addhar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/pen_no"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_pen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_3sdp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/house_pun"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_house"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                        </LinearLayout>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardCornerRadius="@dimen/_15sdp"
                    app:cardBackgroundColor="#E4FCE6"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:orientation="vertical">
                        <!-- <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:layout_alignParentStart="true"
                             android:fontFamily="@font/ubuntu_light"
                             android:text="Student Details"
                             android:textColor="@color/module"
                             android:layout_gravity="center"
                             android:textSize="@dimen/_18sp"
                             android:textStyle="bold" />-->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_15sdp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="18sp"
                                android:layout_height="18sp"
                                android:layout_gravity="center"
                                android:src="@drawable/student_icon_home" />

                            <TextView
                                android:id="@+id/tv_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />


                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_marginHorizontal="@dimen/_15sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp">

                            <ImageView
                                android:layout_width="18sp"
                                android:layout_height="18sp"
                                android:layout_gravity="center"
                                android:src="@drawable/call_parent_id" />

                            <TextView
                                android:id="@+id/tv_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:textColor="@color/module"
                                android:textSize="@dimen/_16sdp"
                                android:textStyle="bold" />

                        </LinearLayout>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_parent_escort_image"
                    android:layout_width="match_parent"
                    android:visibility="visible"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#E4FCE6"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardCornerRadius="@dimen/_15sdp"
                    android:layout_marginBottom="@dimen/_120sdp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginVertical="@dimen/_10sdp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_marginStart="@dimen/_15sdp"
                                android:fontFamily="@font/ubuntu_light"
                                android:text="@string/parent_guardian_details"
                                android:textColor="@color/module"
                                android:layout_gravity="center"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:src="@drawable/edit_pencil" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:layout_height="wrap_content"
                            android:gravity="center">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">


                                <FrameLayout
                                    android:id="@+id/fram_l_father"
                                    android:layout_width="@dimen/_80sdp"
                                    android:layout_height="@dimen/_80sdp"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_15sdp"
                                    android:background="@drawable/profile_image_circuler_bg_red">

                                    <de.hdodenhof.circleimageview.CircleImageView
                                        android:id="@+id/circleImageViewFather"
                                        android:layout_width="@dimen/_70sdp"
                                        android:layout_height="@dimen/_70sdp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_no_profile_big"
                                        app:civ_border_color="@color/white"
                                        app:srcCompat="@drawable/ic_no_profile_big" />

                                    <ImageView
                                        android:id="@+id/iv_father_pic_edit"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_gravity="start|center"
                                        android:layout_marginTop="@dimen/_25sdp"
                                        android:visibility="visible"
                                        app:srcCompat="@drawable/student_reject_icon"/>

                                </FrameLayout>


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:fontFamily="@font/ubuntu_light"
                                    android:text="@string/father"
                                    android:textColor="@color/module"
                                    android:textSize="@dimen/_12sdp"
                                    android:layout_marginBottom="@dimen/_5sdp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_weight="1"
                                >

                                <FrameLayout
                                    android:id="@+id/fram_l_mother"
                                    android:layout_width="@dimen/_80sdp"
                                    android:layout_height="@dimen/_80sdp"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_15sdp"
                                    android:background="@drawable/profile_image_circuler_bg_red"
                                    >

                                    <de.hdodenhof.circleimageview.CircleImageView
                                        android:id="@+id/circleImageViewMother"
                                        android:layout_width="@dimen/_70sdp"
                                        android:layout_height="@dimen/_70sdp"
                                        android:src="@drawable/ic_no_profile_big"
                                        app:civ_border_color="@color/white"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_no_profile_big" />

                                    <ImageView
                                        android:id="@+id/iv_mother_pic_edit"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_gravity="start|center"
                                        android:layout_marginTop="@dimen/_25sdp"
                                        android:visibility="visible"
                                        app:srcCompat="@drawable/student_reject_icon"/>

                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:fontFamily="@font/ubuntu_light"
                                    android:text="@string/mother"
                                    android:textColor="@color/module"
                                    android:textSize="@dimen/_12sdp"
                                    android:layout_marginBottom="@dimen/_5sdp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:layout_weight="1"
                                >

                                <FrameLayout
                                    android:id="@+id/fram_l_escort"
                                    android:layout_width="@dimen/_80sdp"
                                    android:layout_height="@dimen/_80sdp"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="@dimen/_15sdp"
                                    android:background="@drawable/profile_image_circuler_bg_red"
                                    >

                                    <de.hdodenhof.circleimageview.CircleImageView
                                        android:id="@+id/circleImageViewEscort"
                                        android:layout_width="@dimen/_70sdp"
                                        android:layout_height="@dimen/_70sdp"
                                        android:src="@drawable/ic_no_profile_big"
                                        app:civ_border_color="@color/white"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_no_profile_big" />

                                    <ImageView
                                        android:id="@+id/iv_escort_pic_edit"
                                        android:layout_width="@dimen/_25sdp"
                                        android:layout_height="@dimen/_25sdp"
                                        android:layout_gravity="start|center"
                                        android:layout_marginTop="@dimen/_25sdp"
                                        android:visibility="visible"
                                        app:srcCompat="@drawable/student_reject_icon"/>

                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:fontFamily="@font/ubuntu_light"
                                    android:text="@string/guardian"
                                    android:textColor="@color/module"
                                    android:textSize="@dimen/_12sdp"
                                    android:layout_marginBottom="@dimen/_5sdp"
                                    android:textStyle="bold" />

                            </LinearLayout>







                        </LinearLayout>




                    </LinearLayout>

                </androidx.cardview.widget.CardView>



            </LinearLayout>
        </ScrollView>

    </LinearLayout>



</RelativeLayout>