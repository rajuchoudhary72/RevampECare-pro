<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="item"
            type="com.app.ecarepro.model.Student" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        tools:targetApi="jelly_bean">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.1"
                android:orientation="horizontal"
                android:paddingBottom="3dp">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/civ_stu_img"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_gravity="center_vertical"
                    app:srcCompat="@drawable/default_profile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_3sdp">

                    <TextView
                        android:id="@+id/tv_stu_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lines="2"
                        android:textColor="#545454"
                        android:textSize="@dimen/_11sdp"
                        android:visibility="visible"
                        tools:text=" Raju susdsfdsfewreup" />

                    <TextView
                        android:id="@+id/tv_key_value4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:textColor="#5B5B5B"
                        android:textSize="@dimen/_10sdp"
                        tools:text="dhfkdsklhflkdgfdsfg erh" />

                    <TextView
                        android:id="@+id/tv_key_value1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:textColor="#5B5B5B"
                        android:textSize="@dimen/_9sdp"
                        android:visibility="visible"
                        tools:text=" Raju fdsfdsfdsdfdsfd" />

                    <TextView
                        android:id="@+id/tv_key_value2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:textColor="#5B5B5B"
                        android:textSize="@dimen/_8sdp"
                        android:visibility="visible"
                        tools:text="dhfkdsklhflkdgfdsfg" />

                    <TextView
                        android:id="@+id/tv_key_value3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_light"
                        android:textColor="#5B5B5B"
                        android:textSize="@dimen/_7sdp"
                        tools:text="dhfkdsklhflkdgfdsfg erh" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="@dimen/_3sdp"
                android:layout_weight="0.9"
                android:gravity="center_vertical"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:layout_weight="0.4"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="New Class" />

                    <TextView
                        android:id="@+id/edtRoll"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="25dp"
                        android:layout_gravity="end"
                        android:background="@drawable/edit_text_box_round_app_color"
                        android:gravity="center"
                        android:hint="New Class"
                        android:inputType="number"
                        android:textColor="#5B5B5B"
                        android:textColorHint="#5B5B5B" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_weight="0.5"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="New Section" />

                    <TextView
                        android:id="@+id/edtSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:background="@drawable/edit_text_box_round_app_color"
                        android:gravity="center"
                        android:hint="New Section"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textColor="#5B5B5B"
                        android:textColorHint="#5B5B5B" />


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="#e5e5e5" />

    </LinearLayout>
</layout>
