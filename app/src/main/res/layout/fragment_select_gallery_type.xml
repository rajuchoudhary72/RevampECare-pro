<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        tools:context=".ui.gallery.SelectGalleryTypeFragment">


        <TextView
            android:id="@+id/tv_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:textColor="@color/grey_80"
            android:textSize="21sp"
            android:layout_margin="20dp"
            app:drawableTopCompat="@drawable/ic_subject_attendance"
            android:text="@string/photo"
            android:layout_gravity="center"
            android:gravity="center"
            app:fontFamily="@font/ubuntu_medium" />

        <TextView
            android:id="@+id/tv_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:textSize="21sp"
            android:textColor="@color/grey_80"
            android:text="@string/video"
            android:layout_margin="20dp"
            android:layout_gravity="center"
            android:gravity="center"
            app:drawableTopCompat="@drawable/ic_class_attendance"
            app:fontFamily="@font/ubuntu_medium" />

        <TextView
            android:id="@+id/tv_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:textSize="21sp"
            android:textColor="@color/grey_80"
            android:text="@string/favourate"
            android:layout_margin="20dp"
            android:layout_gravity="center"
            android:gravity="center"
            app:drawableTopCompat="@drawable/ic_out_pass_students"
            app:fontFamily="@font/ubuntu_medium" />


    </LinearLayout>
</layout>