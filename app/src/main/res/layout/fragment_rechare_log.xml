<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.sms_app_msg_report.recharge_log.RechargeLogFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_light_primary"
        android:elevation="8dp"
        app:layout_collapseMode="pin"
        app:navigationIcon="@drawable/ic_arrow_back_24px"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Recharge Log"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/titleTextAppearance"
        app:titleTextColor="@color/white" />


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cl_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            style="@style/Widget.MaterialComponents.AppBarLayout.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"


            >

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@android:color/transparent"
                app:expandedTitleTextAppearance="@android:color/transparent"
                app:layout_scrollFlags="scroll|enterAlways"
                app:statusBarScrim="@android:color/transparent">


                <LinearLayout
                    android:id="@+id/ll_toole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?actionBarSize"
                    android:background="@color/md_theme_light_primary"
                    android:fitsSystemWindows="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_collapseMode="parallax"
                    app:layout_scrollFlags="scroll|enterAlways">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_box_rectangle_white_round"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginTop="3dp">

                        <TextView
                            android:id="@+id/dateFrom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="@font/ubuntu_regular"
                            android:padding="13dp"
                            android:textSize="16sp"
                            android:layout_alignParentStart="true"
                            android:text="@string/from_date" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:layout_centerInParent="true" />

                        <TextView
                            android:id="@+id/dateTo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/ubuntu_regular"
                            android:gravity="center"
                            android:padding="13dp"
                            android:textSize="16sp"
                            android:text="@string/to_date" />

                    </RelativeLayout>


                    <LinearLayout
                        android:id="@+id/llHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_45sdp"
                        android:background="@color/grey_light"
                        android:visibility="visible"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvSNo"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="wrap_content"
                             android:textSize="@dimen/_11sdp"
                            android:text="@string/s_no"
                            android:padding="@dimen/_5sdp"
                            android:layout_gravity="center"
                            android:textColor="@color/black"
                            android:fontFamily="@font/ubuntu_medium"
                            />
                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/date"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                             />

                        <TextView
                            android:id="@+id/tvPreviousBal"
                            android:layout_width="@dimen/_70sdp"
                            android:layout_height="wrap_content"
                             android:textSize="@dimen/_11sdp"
                            android:text="@string/previous_balance"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/ubuntu_medium"
                            />
                        <TextView
                            android:id="@+id/tvRechargedVolume"
                            android:layout_width="@dimen/_70sdp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/recharged_volume"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/tvAmountPaid"
                            android:layout_width="@dimen/_60sdp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/amount_paid"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"/>

                        <TextView
                            android:id="@+id/tvNewBalance"
                            android:layout_width="@dimen/_60sdp"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/new_balance"
                            android:gravity="center"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"/>

                        <TextView
                            android:id="@+id/tvRemarks"
                            android:layout_width="@dimen/_150sdp"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/ubuntu_medium"
                            android:textSize="@dimen/_11sdp"
                            android:text="@string/remarks"
                            android:gravity="center_vertical"
                            android:padding="@dimen/_5sdp"
                            android:textColor="@color/black"/>
                    </LinearLayout>


                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_sms_usage_report"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/sms_report_item"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"

            />

        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/ubuntu_medium"
            android:gravity="center"
            android:text="@string/no_data_found"
            android:textSize="16sp"
            android:visibility="gone"

            />



    </androidx.coordinatorlayout.widget.CoordinatorLayout>




</androidx.coordinatorlayout.widget.CoordinatorLayout>