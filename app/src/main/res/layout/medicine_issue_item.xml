<?xml version="1.0" encoding="utf-8"?>
<layout>


<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    app:cardBackgroundColor="#FAFAFA"
    app:cardCornerRadius="@dimen/_15sdp"
    android:layout_marginHorizontal="@dimen/_18sdp"
    android:layout_marginVertical="@dimen/_9sdp"
    android:layout_height="wrap_content">


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_13sdp"
            android:layout_marginRight="@dimen/_10sdp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_medicine_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/ubuntu_light"
                    android:textStyle="bold"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_18sdp" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:weightSum="3"
                >

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_12sdp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:background="#E0E0E0"
                    />

                <TextView
                    android:id="@+id/tv_in_time"
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ubuntu_light"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_12sdp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="@dimen/_15sdp"
                    android:background="#E0E0E0"
                    android:layout_marginHorizontal="@dimen/_5sdp"

                    />

                <TextView
                    android:id="@+id/tv_out_time"
                    android:layout_width="wrap_content"
                    android:fontFamily="@font/ubuntu_light"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_12sdp" />



            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason To Visit Infirmary: "
                    android:textSize="@dimen/_18sdp"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_40"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="@dimen/_18sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="italic" />

            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_10sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diagnosis: "
                    android:textSize="@dimen/_18sdp"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_diagnosis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_40"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="@dimen/_18sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="italic" />

            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_10sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Treatment: "
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_18sdp" />

                <TextView
                    android:id="@+id/tv_remark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_40"
                    android:fontFamily="@font/ubuntu_light"
                    android:textStyle="italic"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>


            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attended By: "
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_18sdp"
                    />

                <TextView
                    android:id="@+id/tv_attdent_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_40"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informed To Parent: "
                    android:textStyle="bold"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_40"
                    android:textSize="@dimen/_18sdp" />

                <TextView
                    android:id="@+id/tv_inf_parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_40"
                    android:fontFamily="@font/ubuntu_light"
                    android:textSize="@dimen/_18sdp" />

            </LinearLayout>







        </LinearLayout>



    </LinearLayout>


</androidx.cardview.widget.CardView>
</layout>