<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_300sdp"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="@dimen/_5sdp"
    android:background="@color/brand_color">

    <ImageView
        android:id="@+id/iv_cancel"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentEnd="true"
        android:padding="@dimen/_5sdp"
        app:srcCompat="@drawable/cross1"
        app:tint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_agree"
        android:layout_below="@+id/iv_cancel"

        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTCHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/ubuntu_medium"
                android:gravity="center"
                android:padding="@dimen/_7sdp"
                android:text="@string/term_and_conditions"
                android:textColor="@color/white"
                android:textSize="@dimen/_20sdp"
                 />

            <TextView
                android:id="@+id/tv_tc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_light"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sdp"
                 />

            <TextView
                android:id="@+id/tv_in_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/ubuntu_medium"
                android:padding="@dimen/_7sdp"
                android:text="@string/important_notes_leave"
                android:textColor="@color/white"
                android:textSize="@dimen/_20sdp"
                 />

            <TextView
                android:id="@+id/tv_imp_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_light"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sdp"
                 />

            <TextView
                android:id="@+id/tv_rfl_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/ubuntu_medium"
                android:padding="@dimen/_7sdp"
                android:text="@string/rules_for_leave"
                android:textColor="@color/white"
                android:textSize="@dimen/_20sdp"
                 />

            <TextView
                android:id="@+id/tv_rfl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_light"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sdp"
                 />


        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_agree"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/background_box_rectangle_rounded"
        android:text="@string/lbl_agree"
        android:textColor="@color/white" />
</RelativeLayout>