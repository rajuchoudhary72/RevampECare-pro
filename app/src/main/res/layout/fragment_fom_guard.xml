<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.fom_guard.FomGuardFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/md_theme_light_primary"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back_24px"
                app:titleCentered="true"
                android:elevation="8dp"
                app:title="@string/guard_app"

                app:titleTextAppearance="?attr/titleTextAppearance"
                app:titleTextColor="@color/white"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/grey_10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/ubuntu_bold"
                     android:textSize="18sp"
                     android:layout_centerVertical="true"
                    android:layout_gravity="center" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_10sdp"

                    >

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                         android:hint="@string/date"

                        >

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/startDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:layout_gravity="center"
                            android:gravity="center"

                            android:inputType="none"
                            />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_appointment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:listitem="@layout/appointment_list_item"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                 android:layout_marginBottom="@dimen/_150sdp" />


        </LinearLayout>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentBottom="true"
            app:cardBackgroundColor="@color/grey_10"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="0dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:weightSum="2"
                android:layout_height="match_parent"

                >

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_check_in"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_marginVertical="@dimen/_25sdp"
                    android:layout_marginStart="@dimen/_25sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/accent_color">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/ubuntu_bold"
                            android:text="@string/check_in"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:layout_centerInParent="true" />

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_walk_in"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/_10sdp"
                    android:layout_marginVertical="@dimen/_25sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_25sdp"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/brand_color">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/ubuntu_bold"
                            android:text="@string/walk_in"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:layout_centerInParent="true" />

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:fontFamily="@font/ubuntu_medium"
            android:layout_gravity="center"
            android:gravity="center"
             android:text="@string/general_no_data_found"
            android:textSize="16sp"
            android:visibility="gone"
            android:layout_centerInParent="true"

            />


    </RelativeLayout>
</layout>