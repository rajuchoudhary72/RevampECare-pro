<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:targetApi="jelly_bean">

    <include
        android:id="@+id/include_toolbar"
        layout="@layout/common_toolbar"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:background="@color/white"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:layout_weight="1"
                android:paddingEnd="@dimen/_5sdp">

                <Spinner
                    android:id="@+id/spClass"
                    style="@style/SpinnerThemeAtt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:dropDownVerticalOffset="50dp"

                    android:paddingLeft="@dimen/_5sdp"
                    android:paddingRight="@dimen/_5sdp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_weight="1"
                android:layout_margin="@dimen/_5sdp"
                android:paddingEnd="@dimen/_5sdp">

                <Spinner
                    android:id="@+id/spOrder"
                    style="@style/SpinnerThemeAtt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"

                    android:paddingLeft="@dimen/_5sdp"
                    android:overlapAnchor="false"
                    android:paddingRight="@dimen/_5sdp"
                    android:dropDownVerticalOffset="50dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llstoppes"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:background="@color/brand_color"
        android:visibility="gone">

        <TextView
            android:id="@+id/ctv_select_stoppage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginLeft="@dimen/_11sdp"
            android:layout_marginRight="@dimen/_11sdp"
            android:layout_weight="1"
            android:background="@drawable/background_box_rectangle_white"
            android:fontFamily="@font/ubuntu_light"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_10sdp"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:text="Select Stoppage"
            android:textColor="@color/module"
            android:textSize="@dimen/_14sdp"
            android:visibility="visible"
            app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_stu_att"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_no_record"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/no_record_found"
        android:textSize="25sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
