<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        tools:context=".ui.assignment.staff.postAssignment.PostAssignmentFragment">

        <include
            android:id="@+id/include_toolbar"
            layout="@layout/common_toolbar"
            />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            >



            <LinearLayout
                android:id="@+id/llMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"

                >



                    <RadioGroup
                        android:id="@+id/radioGroup_wisesubmission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp"
                        android:layout_gravity="center"
                        android:checkedButton="@id/rbClassWise"
                        >

                        <RadioButton
                            android:id="@+id/rbClassWise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/class_wise"
                            android:layout_marginEnd="@dimen/_15sdp"
                            />

                        <RadioButton
                            android:id="@+id/rbStudentWise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/student_wise"
                            />


                    </RadioGroup>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSelectSubject"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_line"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:text="@string/select_subject"
                        android:visibility="visible"
                        app:drawableRightCompat="@drawable/ic_dropdown_spinner" />

                    <TextView
                        android:id="@+id/tvSelectClass"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_line"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:text="@string/lbl_select_class"

                        android:visibility="visible"
                        app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectstudent"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_line"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="@string/general_select_Student"

                    android:visibility="gone"
                    app:drawableRightCompat="@drawable/ic_dropdown_spinner" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/ctvAssignmentDt"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_line"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:text="@string/assignment_assignment_date"

                        android:visibility="visible" />


                    <TextView
                        android:id="@+id/tvSubmissionDt"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_line"
                        android:fontFamily="@font/ubuntu_light"
                        android:gravity="center_vertical"
                        android:padding="10dp"
                        android:text="@string/assignment_submission_date"

                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="5dp"
                    android:background="@drawable/shape_line">

                    <CheckBox
                        android:id="@+id/isSubmitDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/ubuntu_medium"
                        android:text="@string/assignment_submission_date"

                        />


                </LinearLayout>


                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/shape_line"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:hint="@string/general_title_pun"
                    android:lines="1"
                    android:padding="10dp"
                    android:visibility="visible" />

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/shape_line"
                    android:fontFamily="@font/ubuntu_light"
                    android:gravity="center_vertical"
                    android:hint="@string/assignment_type_your_assignment"
                    android:lines="4"
                    android:maxLines="6"
                    android:padding="10dp"
                    android:visibility="visible" />



                    <LinearLayout
                        android:id="@+id/llFile"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="8dp"
                        android:background="@drawable/rectangle_border_gray_corner_radius"
                        android:gravity="center_vertical"
                        android:padding="7dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:fontFamily="@font/ubuntu_medium"
                            android:lines="1"
                            android:padding="7dp"
                            android:text="@string/general_attachment"
                            android:textColor="#545454" />

                        <ImageView
                            android:id="@+id/ivFileRemove"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:visibility="visible"
                            app:srcCompat="@drawable/tb_doc_picker_ic_icon_cancel" />

                    </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/grey_light"
                    android:layout_marginBottom="@dimen/_15sdp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_browse_photo"
                            android:layout_width="0dp"
                            android:layout_weight="0.8"
                            android:layout_height="wrap_content"
                            android:drawablePadding="3dp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:padding="5dp"
                            android:text="@string/browse_photo"
                            app:drawableTopCompat="@drawable/ic_camera"
                            android:gravity="bottom|center" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:background="@color/grey_light"
                            android:layout_marginVertical="3dp" />

                        <TextView
                            android:layout_weight="1"
                            android:id="@+id/tv_browse_file"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:drawablePadding="3dp"
                            android:fontFamily="@font/ubuntu_medium"
                            android:padding="5dp"
                            android:text="@string/general_attach_photo_pdf_doc"
                            app:drawableTopCompat="@drawable/ic_add_account"
                            android:gravity="bottom|center" />

                    </LinearLayout>

                </LinearLayout>




                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:fontFamily="@font/ubuntu_light"
                    android:text="@string/assignment_support_file_size" />

                <CheckBox
                    android:id="@+id/cbMultipleActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/assignment_allow_student_for_multiple_submission"

                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbLateSubmission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/allow_student_for_late_submission"

                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/cbActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/ubuntu_medium"
                    android:text="@string/general_active" />

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="12dp"
                    android:fontFamily="@font/ubuntu_light"
                    android:text="@string/lbl_submit"
                    android:textColor="@color/white" />


            </LinearLayout>
        </ScrollView>


    </LinearLayout>
</layout>