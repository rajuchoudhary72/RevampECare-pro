<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/_8sdp"
        android:paddingRight="@dimen/_8sdp"
        android:paddingTop="@dimen/_8sdp"
        app:cardCornerRadius="16dp"
        app:contentPadding="12dp"
        app:strokeColor="@color/grey_60"
        android:layout_margin="@dimen/_5sdp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/include_person_details_top"

                layout="@layout/like_by_single_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <TextView
                android:id="@+id/tv_sms_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
               android:layout_marginStart="@dimen/_25sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_regular"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/module"
                android:padding="@dimen/_2sdp" />

            <TextView
                android:id="@+id/tv_sms_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_regular"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:padding="@dimen/_2sdp" />

            <TextView
                android:id="@+id/tv_sms_typ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:fontFamily="@font/ubuntu_regular"
                android:padding="@dimen/_2sdp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                >
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_regular"
                    android:padding="@dimen/_2sdp"
                    />
                <TextView
                    android:id="@+id/tv_status_on"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:fontFamily="@font/ubuntu_regular"
                    android:padding="@dimen/_2sdp"

                    />
            </LinearLayout>

            <include
                android:id="@+id/include_person_details_bottom"
                layout="@layout/like_by_single_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>