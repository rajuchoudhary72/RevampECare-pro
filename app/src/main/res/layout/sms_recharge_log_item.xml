<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="rechargeLog"
            type="com.app.ecarepro.model.RechargeLog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_2sdp">

            <TextView
                android:id="@+id/tvSNo"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:padding="@dimen/_5sdp"
                android:layout_gravity="center"
                android:textColor="@color/grey_60" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@{rechargeLog.date}"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/grey_60" />

            <TextView
                android:id="@+id/tvPreviousBal"
                android:layout_width="@dimen/_70sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@{rechargeLog.prevBalance}"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/grey_60" />

            <TextView
                android:id="@+id/tvRechargedVolume"
                android:layout_width="@dimen/_70sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@{rechargeLog.rechargedVol}"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/grey_60" />

            <TextView
                android:id="@+id/tvAmountPaid"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@{rechargeLog.amountPaid}"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/grey_60" />

            <TextView
                android:id="@+id/tvNewBalance"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:gravity="center"
                android:text="@{rechargeLog.newBalance}"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/grey_60" />

            <TextView
                android:id="@+id/tvRemarks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/ubuntu_medium"
                android:textSize="@dimen/_11sdp"
                android:padding="@dimen/_5sdp"
                android:ellipsize="end"
                android:text="@{rechargeLog.remarks}"
                android:textColor="@color/grey_60" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/grey_light" />
    </LinearLayout>
</layout>