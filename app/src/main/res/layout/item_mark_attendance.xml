<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_87sdp"
            android:padding="@dimen/_10sdp">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/user_img"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ECarePro.ImageView.Circle"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"

                 />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_10sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_stu_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/ubuntu_medium"
                    android:lines="1"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/tv_admission_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/tv_roll_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/ubuntu_light"
                    android:textColor="@color/grey_60"
                    android:textSize="@dimen/_8sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:gravity="end"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:orientation="horizontal">



                    <TextView
                        android:id="@+id/tv_mark_late"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:layout_gravity="end"
                        android:background="@drawable/circle_gray_att"
                        android:gravity="center"
                        android:text="Lt"
                        android:visibility="gone"
                        android:textColor="@color/grey_light_compose_msg_headr_txt" />
                     <View
                        android:id="@+id/viewLine"
                        android:layout_width="@dimen/_1sdp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:background="@color/grey_40" />

                    <TextView
                        android:id="@+id/tv_mark_present"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:background="@drawable/circle_gray_att"
                        android:gravity="center"
                        android:text="@string/p"
                        android:textColor="@color/grey_light_compose_msg_headr_txt" />

                    <View
                        android:layout_width="@dimen/_1sdp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:background="@color/grey_40" />

                    <TextView
                        android:id="@+id/tv_mark_absent"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:background="@drawable/circle_gray_att"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@color/grey_light_compose_msg_headr_txt" />

                    <View
                        android:layout_width="@dimen/_1sdp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:background="@color/grey_40" />

                    <TextView
                        android:id="@+id/tv_mark_leave"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:layout_gravity="end"
                        android:background="@drawable/circle_gray_att"
                        android:gravity="center"
                        android:text="L"
                        android:textColor="@color/grey_light_compose_msg_headr_txt" />


                    <View
                        android:layout_width="@dimen/_1sdp"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:visibility="visible"
                        android:background="@color/grey_40" />

                    <TextView
                        android:id="@+id/tv_mark_na"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:layout_gravity="end"
                        android:background="@drawable/circle_gray_att"
                        android:gravity="center"
                        android:text="NA"
                        android:visibility="visible"
                        android:textColor="@color/grey_light_compose_msg_headr_txt" />
                </LinearLayout>



            </LinearLayout>

        </LinearLayout>


        <TextView
            android:id="@+id/tv_approve_leave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
             android:gravity="center"
            android:text="@string/approved_leave"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:visibility="gone"

            android:textColor="@color/accent_color" />


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/grey_40" />

    </LinearLayout>
</layout>