<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.app.ecarepro.ui.define_skill.DefineSkillViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            style="@style/Widget.MaterialComponents.AppBarLayout.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:menu="@menu/menu_main"
                app:navigationIcon="@drawable/ic_arrow_back_24px"
                app:title="Define Skill"
                app:titleTextAppearance="@style/TextAppearance.ECarePro.Toolbar"
                app:titleTextColor="@color/white">

                <ImageView
                    android:id="@+id/btn_search"
                    isVisible="@{!viewModel.searchViewVisibility}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{v -> viewModel.toggleSearchView()}"
                    android:layout_gravity="end"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="@dimen/_8sdp"
                    android:src="@drawable/ic_search"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    isVisible="@{viewModel.searchViewVisibility}"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:animateLayoutChanges="true"
                    tools:visibility="gone">

                    <EditText
                        android:id="@+id/searchView"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_outline_round_corner_green_100"
                        android:backgroundTint="@color/white"
                        android:drawableStart="@drawable/round_search_24"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/green"
                        android:fontFamily="@font/calibri_regular"
                        android:hint="@string/search"
                        android:inputType="text"
                        android:paddingStart="@dimen/_10sdp"
                        android:paddingEnd="@dimen/_25sdp"
                        android:text="@={viewModel.searchQuery}"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="Autofill" />


                    <ImageView
                        android:id="@+id/btn_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:onClick="@{v -> viewModel.clearSearchQuery()}"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/round_close_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/searchView"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/black" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_skills"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:hint="@string/select_skill"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <AutoCompleteTextView
                    android:id="@+id/select_skill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/calibri_regular"
                    android:inputType="none"
                    tools:ignore="LabelFor" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_skill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_16sdp"
                android:fontFamily="@font/calibri_bold"
                android:includeFontPadding="false"
                android:text="Create New Skill"
                android:textAllCaps="true"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@+id/btn_import_skill"
                app:layout_constraintEnd_toStartOf="@id/btn_import_skill"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btn_import_skill"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerSmall" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:id="@+id/btn_import_skill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:strokeColor="?attr/colorPrimary"
                android:layout_marginEnd="@dimen/_16sdp"
                android:fontFamily="@font/calibri_bold"
                android:includeFontPadding="false"
                android:text="Import from Database"
                android:textAllCaps="true"
                android:textSize="10sp"
                app:icon="@drawable/outline_file_download_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_create_skill"
                app:layout_constraintTop_toBottomOf="@+id/til_skills"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerSmall" />


            <com.airbnb.epoxy.EpoxyRecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_import_skill"
                tools:listitem="@layout/item_define_skill" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>