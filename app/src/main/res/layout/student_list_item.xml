<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="studentData"
            type="com.app.ecarepro.model.Student" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical"

            >


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/circleImageViewProfile"
                imageUrl="@{studentData.photo}"
                placeholder="@{@drawable/default_profile}"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ECarePro.ImageView.Circle"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp"
                 />

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                 android:paddingHorizontal="6dp"
                android:ellipsize="end"
                android:text="@{studentData.name}"
                android:lines="2"
                android:textColor="@color/black"
                android:gravity="center"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/admission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"
                 android:paddingHorizontal="6dp"
                android:gravity="center"
                android:textAlignment="center"

                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_class_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"

                android:gravity="center"
                android:textAlignment="center"
                 android:paddingHorizontal="6dp"
                  />
            <TextView
                android:id="@+id/rollno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"

                 android:gravity="center"
                android:textAlignment="center"
                 android:layout_marginBottom="10dp"
                android:paddingHorizontal="6dp"
                  />





        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="2dp"
            android:layout_height="200dp"
            android:layout_alignParentEnd="true"
            />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="2dp"
           android:layout_alignParentBottom="true"
            />



    </RelativeLayout>

 </layout>