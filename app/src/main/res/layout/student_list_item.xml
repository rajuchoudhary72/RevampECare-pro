<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="studentData"
            type="com.app.ecarepro.model.Student" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/white"
        >

        <LinearLayout
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            >


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/circleImageViewProfile"
                imageUrl="@{studentData.photo}"
                placeholder="@{@drawable/default_profile}"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ECarePro.ImageView.Circle"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp"
                 />

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                 android:paddingHorizontal="6dp"
                android:ellipsize="end"
                android:text="@{studentData.name}"
                android:lines="2"
                android:textColor="@color/black"
                android:gravity="center"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/admission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"
                 android:paddingHorizontal="6dp"
                android:gravity="center"
                android:textAlignment="center"

                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_class_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"

                android:gravity="center"
                android:textAlignment="center"
                 android:paddingHorizontal="6dp"
                  />
            <TextView
                android:id="@+id/rollno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:ellipsize="end"

                 android:gravity="center"
                android:textAlignment="center"
                 android:layout_marginBottom="10dp"
                android:paddingHorizontal="6dp"
                  />


            <LinearLayout
                android:id="@+id/ll_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="@dimen/_4sdp"
                android:layout_marginBottom="@dimen/_4sdp"
               >

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_view"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/green"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="@dimen/_4sdp"

                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:layout_gravity="center"
                        android:text="@string/view"
                        android:textColor="@color/white"
                        />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_add"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/green"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="@dimen/_4sdp"
                    android:layout_marginStart="@dimen/_4sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5sdp"
                        android:layout_gravity="center"
                        android:text="@string/add"
                        android:textColor="@color/white"
                        />
                </androidx.cardview.widget.CardView>


            </LinearLayout>



        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>

 </layout>