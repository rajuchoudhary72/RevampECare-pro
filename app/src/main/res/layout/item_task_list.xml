<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="title"
            type="com.app.ecarepro.model.Title" />

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewSnoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sno: "
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewSnoValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text='@{""+title.tlId}'
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintEnd_toStartOf="@id/imageViewEdit"
                app:layout_constraintStart_toEndOf="@id/textViewSnoLabel"
                app:layout_constraintTop_toTopOf="@id/textViewSnoLabel"
                tools:text="4" />

            <ImageView
                android:id="@+id/imageViewEdit"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_height="wrap_content"
                android:contentDescription="Edit"
                android:src="@drawable/ic_edit"
                android:onClick="@{clickListener}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/textViewTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Title: "
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewSnoLabel" />

            <TextView
                android:id="@+id/textViewTitleValue"
                android:layout_width="0dp"
                android:text="@{title.title}"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textViewTitleLabel"
                app:layout_constraintTop_toTopOf="@id/textViewTitleLabel"
                tools:text="iOS-testing-6" />

            <TextView
                android:id="@+id/textViewCreatedOnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Created On: "
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewTitleLabel" />

            <TextView
                android:id="@+id/textViewCreatedOnValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{title.createdOn}"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textViewCreatedOnLabel"
                app:layout_constraintTop_toTopOf="@id/textViewCreatedOnLabel"
                tools:text="01 Aug 2025" />

            <TextView
                android:id="@+id/textViewAssignToLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Assign To: "
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewCreatedOnLabel" />

            <LinearLayout
                android:id="@+id/linearLayoutAssignTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{clickListener}"
                android:background="@drawable/assignee_background"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                app:layout_constraintBottom_toBottomOf="@id/textViewAssignToLabel"
                app:layout_constraintStart_toEndOf="@id/textViewAssignToLabel"
                app:layout_constraintTop_toTopOf="@id/textViewAssignToLabel">

                <ImageView
                    android:id="@+id/imageViewAssigneeIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_assignee"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/textViewAssigneeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text= '@{""+title.assignees.size()}'
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="3" />

                <ImageView
                    android:id="@+id/imageViewAssigneeArrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>