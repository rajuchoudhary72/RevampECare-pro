<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/_8sdp"
        android:paddingRight="@dimen/_8sdp"
        android:paddingTop="@dimen/_8sdp"
        app:cardCornerRadius="16dp"
        app:contentPadding="12dp"
        app:strokeColor="@color/grey_60"
        android:layout_margin="@dimen/_5sdp"
        app:strokeWidth="1dp">



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
         >

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_user_pic"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_centerVertical="false"
            android:padding="@dimen/_7sdp"
            app:srcCompat="@drawable/default_profile" />

        <RelativeLayout
            android:id="@+id/rl_msg_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="false"
            android:layout_toEndOf="@+id/iv_user_pic"
            android:paddingBottom="@dimen/_7sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:paddingStart="@dimen/_7sdp"
            tools:ignore="RtlSymmetry">

            <TextView
                android:id="@+id/tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tv_time_ago"
                android:fontFamily="@font/ubuntu_regular"
                android:lines="1"
                android:ellipsize="end"
                android:textColor="@color/module"
                android:textSize="@dimen/_14sdp"
                app:fontFamily="@font/ubuntu_medium" />

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_below="@+id/tv_subject"
                android:layout_marginTop="@dimen/_3sdp"
                android:ellipsize="end"
                android:fontFamily="@font/ubuntu_light"
                android:lines="1"
                android:textColor="@color/module"
                android:textSize="@dimen/_12sdp"
                app:fontFamily="@font/ubuntu_regular" />

            <TextView
                android:id="@+id/tv_sub_abbre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_message"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tv_time_ago"
                android:ellipsize="end"
                android:fontFamily="@font/ubuntu_light"
                android:lines="1"
                android:maxLines="1"
                android:paddingTop="@dimen/_2sdp"
                android:textColor="@color/module"
                android:textSize="@dimen/_12sdp"
                app:fontFamily="@font/ubuntu_light" />

            <TextView
                android:id="@+id/ctvReadBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_sub_abbre"
                app:drawableLeftCompat="@drawable/ic_green_right_double"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="@font/ubuntu_italic"
                android:textColor="@color/brand_color"
                android:textSize="@dimen/_10sdp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_sub_abbre2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_below="@+id/ctvReadBy"
                android:layout_toStartOf="@+id/tv_time_ago"
                android:fontFamily="@font/ubuntu_light"
                android:lines="1"
                android:paddingTop="@dimen/_2sdp"
                android:textColor="@color/module"
                android:textSize="@dimen/_13sdp"
                android:visibility="visible"
                app:fontFamily="@font/ubuntu_light" />


            <TextView
                android:id="@+id/tv_time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/ubuntu_light"
                android:textColor="@color/grey_40"
                android:textSize="@dimen/_8sdp"
                app:fontFamily="@font/ubuntu_light" />




        </RelativeLayout>


        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/delete"
            android:src="@drawable/delete"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            />

    </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>
