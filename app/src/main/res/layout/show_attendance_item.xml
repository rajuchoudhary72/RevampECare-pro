<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="attData"
            type="com.app.ecarepro.ui.attendance_section.Attendance" />
        <variable
            name="sNo"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/llMain"
        android:layout_height="wrap_content">


        <LinearLayout
            android:id="@+id/llHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:orientation="vertical">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_40" />

                <TextView
                    android:id="@+id/tvAttDate"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
android:textSize="12sp"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@{sNo}"
                    android:fontFamily="@font/ubuntu_regular" />

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_40" />

                <TextView
                    android:id="@+id/tvIn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="0.6"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:text="@{attData.attDate}"
                    android:fontFamily="@font/ubuntu_regular"

                    />

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_40" />

                <TextView
                    android:id="@+id/tvOut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:layout_weight="0.6"
                    android:paddingVertical="10dp"
                    android:text="@{attData.dayName}"
                    android:fontFamily="@font/ubuntu_regular" />

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_40" />

                <TextView
                    android:id="@+id/tvLate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="0.6"
                    android:paddingVertical="10dp"
                    android:textSize="12sp"
                    android:text="@{attData.attendanceStatus()}"
                    android:fontFamily="@font/ubuntu_regular" />


                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_40" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_weight="0.6"
                    android:textSize="12sp"
                    android:paddingVertical="10dp"
                    android:text='@{attData.isLateStatus()}'
                    android:fontFamily="@font/ubuntu_regular" />

                <View
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"
                    android:background="@color/grey_40" />


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/grey_40" />
        </LinearLayout>


    </LinearLayout>
</layout>