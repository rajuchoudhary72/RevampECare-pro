<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearanceOverlay.ECarePro.ImageView.Round.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.ECarePro.ImageView.Round.Top" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.ECarePro.ImageView.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearanceOverlay.ECarePro.BottomRoundedCorner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">34dp</item>
        <item name="cornerSizeBottomRight">34dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.ECarePro.TopRoundedCorner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TextAppearance.ECarePro.Toolbar" parent="TextAppearance.ECarePro.TitleLarge">
        <item name="android:fontFamily">@font/ubuntu_medium</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.ECarePro.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Animations">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>
    <style name="Theme.ECarePro.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.ECarePro.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/popup_rounded_corner</item>
    </style>

    <style name="ECarePro.FullScreenDialog" parent="Theme.MaterialComponents.Light.Dialog">

        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="actionMenuTextColor">@color/colorAccent</item>
    </style>
    <style name="SpinnerThemeAtt" parent="Base.Theme.ECarePro">
        <item name="overlapAnchor">true</item>
        <item name="android:background">@drawable/spinner_background_att</item>
    </style>

</resources>