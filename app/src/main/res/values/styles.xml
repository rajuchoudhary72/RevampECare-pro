<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidth">2dp</item>
    </style>

    <style name="NeumorphButtonShapeAppearance">

        <item name="neumorph_cornerFamily">rounded</item>
        <item name="neumorph_cornerSize">32dp</item>
    </style>


    <style name="CustomShapeAppearance">
        <item name="neumorph_cornerFamily">rounded</item>


        <!-- Or if wants different radii depending on the corner. -->
        <item name="neumorph_cornerSizeTopLeft">12dp</item>
        <item name="neumorph_cornerSizeTopRight">0dp</item>
        <item name="neumorph_cornerSizeBottomLeft">@dimen/_12sdp</item>
        <item name="neumorph_cornerSizeBottomRight">0dp</item>
        

    </style>

    <style name="CustomShapeAppearanceButton">
        <item name="neumorph_cornerFamily">rounded</item>


        <!-- Or if wants different radii depending on the corner. -->
        <item name="neumorph_cornerSizeTopLeft">@dimen/_12sdp</item>
        <item name="neumorph_cornerSizeTopRight">@dimen/_12sdp</item>
        <item name="neumorph_cornerSizeBottomLeft">@dimen/_12sdp</item>
        <item name="neumorph_cornerSizeBottomRight">@dimen/_12sdp</item>


    </style>


    <style name="CustomShapeAppearanceTwo">
        <item name="neumorph_cornerFamily">rounded</item>


        <!-- Or if wants different radii depending on the corner. -->
        <item name="neumorph_cornerSizeTopLeft">0dp</item>
        <item name="neumorph_cornerSizeTopRight">@dimen/_12sdp</item>
        <item name="neumorph_cornerSizeBottomLeft">0dp</item>
        <item name="neumorph_cornerSizeBottomRight">@dimen/_12sdp</item>
    </style>


</resources>