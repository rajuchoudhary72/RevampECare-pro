package com.app.ecarepro.feature.login.analytics

import com.app.ecarepro.analytics.AnalyticsEvent // Implements the generic interface.

/** Analytics event fired when the user initiates a login attempt. */
data class SignInAttemptEvent(private val fromScreen: String) : AnalyticsEvent {
    override val name: String = "sign_in_attempt"
    override val params: Map<String, Any> = mapOf("from_screen" to fromScreen)
}

/** Analytics event fired upon a successful login. */
data class SignInSuccessEvent(private val method: String) : AnalyticsEvent {
    override val name: String = "sign_in_success"
    override val params: Map<String, Any> = mapOf("method" to method)
}

/** Analytics event for a login-related failure. */
data class SignInFailedEvent(private val reason: String) : AnalyticsEvent {
    override val name: String = "sign_in_failed"
    override val params: Map<String, Any> = mapOf("reason" to reason)
}

/** A generic screen view event scoped to the login flow. */
data class LoginScreenViewEvent(private val screenName: String) : AnalyticsEvent {
    override val name: String = "screen_view"
    override val params: Map<String, Any> = mapOf(
        "screen_name" to screenName,
        "flow" to "login" // Example of a flow-specific parameter
    )
}

