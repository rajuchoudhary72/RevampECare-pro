/** Analytics event for when a user successfully verifies a school code. */
data class SchoolCodeVerifiedEvent(private val schoolCode: String) : AnalyticsEvent {
    override val name: String = "school_code_verified"
    override val params: Map<String, Any> = mapOf("school_code" to schoolCode)
}

/** Analytics event for when a school code fails verification. */
data class SchoolCodeFailedEvent(private val schoolCode: String, private val reason: String) : AnalyticsEvent {
    override val name: String = "school_code_failed"
    override val params: Map<String, Any> = mapOf(
        "school_code" to schoolCode,
        "reason" to reason
    )
}


