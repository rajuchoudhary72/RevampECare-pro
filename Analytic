package com.app.ecarepro.feature.schoolcode

// Imports from other modules
import androidx.lifecycle.viewModelScope
import com.app.ecarepro.analytics.AnalyticsManager // <-- Import from :analytics module
import com.app.ecarepro.core.domain.exception.InvalidSchoolCodeException
import com.app.ecarepro.core.domain.repository.SchoolRepository
import com.app.ecarepro.core.ui.viewmodel.BaseViewModel
import com.app.ecarepro.designsystem.core.component.MessageType
import com.app.ecarepro.designsystem.core.component.SnackbarMessage
// Feature-specific analytics events
import com.app.ecarepro.feature.schoolcode.analytics.SchoolCodeFailedEvent
import com.app.ecarepro.feature.schoolcode.analytics.SchoolCodeVerifiedEvent
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.onStart
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.launch
import javax.inject.Inject


@HiltViewModel
class UpdatedSchoolCodeViewModel @Inject constructor(
    private val schoolRepository: SchoolRepository,
    private val analyticsManager: AnalyticsManager // <-- INJECTED
) : BaseViewModel<SchoolCodeIntent, SchoolCodeEvent>() {

    private val _uiState = MutableStateFlow(SchoolCodeUiState())
    val uiState: StateFlow<SchoolCodeUiState> = _uiState.asStateFlow()

    override fun handleIntent(intent: SchoolCodeIntent) {
        // ... existing intent handling
        when (intent) {
            is SchoolCodeIntent.OnCodeChanged -> {
                updateSchoolCode(intent.code)
                // Don't verify on every character change, just update state.
            }
            SchoolCodeIntent.OnNextClicked -> {
                verifySchoolCode()
            }
            // ... other intents
        }
    }

    private fun verifySchoolCode() {
        viewModelScope.launch {
            val schoolCode = uiState.value.schoolCode ?: return@launch
            schoolRepository.getSchoolDetails(schoolCode).onStart {
                _uiState.update { it.copy(isLoading = true) }
            }.collect { result ->
                _uiState.update { it.copy(isLoading = false) }
                if (result.isSuccess) {
                    // Log success event
                    analyticsManager.logEvent(SchoolCodeVerifiedEvent(schoolCode))
                    sendEvent(SchoolCodeEvent.NavigateToNextScreen(schoolCode))
                } else {
                    val exception = result.exceptionOrNull()
                    val reason = exception?.message ?: "Unknown error"

                    // Log failure event
                    analyticsManager.logEvent(SchoolCodeFailedEvent(schoolCode, reason))

                    val message = if (exception is InvalidSchoolCodeException) {
                        SnackbarMessage(reason, type = MessageType.WARNING)
                    } else {
                        SnackbarMessage(reason, type = MessageType.ERROR)
                    }
                    _uiState.update { it.copy(errorMessage = message) }
                }
            }
        }
    }
     private fun updateSchoolCode(code: String) {
        _uiState.update { it.copy(schoolCode = code) }
    }
}
