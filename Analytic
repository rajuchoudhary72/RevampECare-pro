// -------------------------------------------------------------------------------------
// 1. Generic Analytics Event Contract (`:analytics` module)
//
// This is the core abstraction. Any event from any feature module will implement this
// interface. It's simple and will not change.
// -------------------------------------------------------------------------------------

/**
 * A generic interface that all feature-specific analytics events must implement.
 * This contract ensures that every event provides a name and a map of its parameters.
 */
interface AnalyticsEvent {
    /**
     * The name of the event, e.g., "sign_in_success", "school_code_entered".
     * This is what will appear in your analytics provider's dashboard.
     */
    val name: String

    /**
     * A map of key-value pairs that provide context for the event.
     * e.g., mapOf("method" to "password", "from_screen" to "LoginScreen")
     */
    val params: Map<String, Any>
}


// -------------------------------------------------------------------------------------
// 2. Analytics Provider Contract (`:analytics` module)
//
// Defines the contract for any analytics service (Firebase, Adobe, etc.).
// Each provider will have its own implementation of this interface.
// -------------------------------------------------------------------------------------

/**
 * Defines the contract for an analytics service provider.
 */
interface AnalyticsProvider {
    /**
     * Sets a user property or attribute (e.g., user role, school code).
     * @param key The name of the property.
     * @param value The value of the property.
     */
    fun setUserProperty(key: String, value: String)

    /**
     * Logs a custom event.
     * @param event The analytics event to log.
     */
    fun logEvent(event: AnalyticsEvent)
}


// -------------------------------------------------------------------------------------
// 3. The Central Analytics Manager (`:analytics` module)
//
// This is the main class the application will interact with. It manages all registered
// providers and automatically enriches every event with base-level attributes
// (like user_id, is_logged_in, etc.) before dispatching it.
// -------------------------------------------------------------------------------------

/**
 * Manages all analytics tracking by delegating to a list of registered providers.
 * It enriches events with base attributes and provides a single point of entry
 * for logging events and identifying users.
 */
@Singleton
class AnalyticsManager @Inject constructor(
    // Using Hilt's multibinding to inject all available AnalyticsProvider implementations.
    private val providers: Set<@JvmSuppressWildcards AnalyticsProvider>,
    private val tokenProvider: TokenProvider // To get user info for base attributes.
) {

    /**
     * Identifies the user across all analytics providers. Call this after a
     * successful login or when user data is first available.
     *
     * @param user The user model containing details to set as user properties.
     */
    fun identifyUser(user: User) {
        providers.forEach { provider ->
            provider.setUserProperty("user_id", user.userID.toString())
            provider.setUserProperty("user_role", user.roleName ?: "unknown")
            user.schoolCode?.let { provider.setUserProperty("school_code", it) }
        }
    }

    /**
     * Logs an analytics event. It first enriches the event with base attributes
     * and then dispatches it to all registered analytics providers.
     *
     * @param event The feature-specific event to log, which implements [AnalyticsEvent].
     */
    fun logEvent(event: AnalyticsEvent) {
        // 1. Create a combined map of base attributes + event-specific attributes.
        val enrichedParams = buildBaseAttributes() + event.params

        // 2. Create a new anonymous object that represents the final, enriched event.
        val enrichedEvent = object : AnalyticsEvent {
            override val name: String = event.name
            override val params: Map<String, Any> = enrichedParams
        }

        // 3. Dispatch the enriched event to all providers.
        providers.forEach { it.logEvent(enrichedEvent) }
    }

    /**
     * Constructs a map of base attributes to be included with every event.
     * This ensures consistency and reduces boilerplate in feature modules.
     */
    private fun buildBaseAttributes(): Map<String, Any> {
        // runBlocking is acceptable here as TokenProvider should be fast, reading from memory/DataStore.
        // This is a rare exception where blocking on the calling thread is simple and effective.
        val currentUser = runBlocking { tokenProvider.getActiveUser().first() }

        return mapOf(
            "timestamp_utc" to System.currentTimeMillis(),
            "is_logged_in" to (currentUser != null),
            "user_id" to (currentUser?.userID?.toString() ?: "guest")
            // Add other global attributes like app_version, os_version, etc. here.
        )
    }
}


// -------------------------------------------------------------------------------------
// 4. Concrete Firebase Implementation (`:analytics` module)
//
// An example of a concrete implementation for Firebase Analytics.
// -------------------------------------------------------------------------------------

package com.app.ecarepro.analytics.firebase

// All required imports are already at the top of the file.

@Singleton
class FirebaseAnalyticsProvider @Inject constructor(
    @ApplicationContext context: Context
) : AnalyticsProvider {

    private val firebaseAnalytics = FirebaseAnalytics.getInstance(context)

    override fun setUserProperty(key: String, value: String) {
        firebaseAnalytics.setUserProperty(key, value)
    }

    override fun logEvent(event: AnalyticsEvent) {
        val bundle = Bundle().apply {
            event.params.forEach { (key, value) ->
                // Firebase Analytics values must be String, Long, or Double.
                // We convert everything to String for simplicity.
                putString(key, value.toString())
            }
        }
        firebaseAnalytics.logEvent(event.name, bundle)
    }
}


// -------------------------------------------------------------------------------------
// 5. Dependency Injection with Hilt (`:analytics` module)
//
// This Hilt module binds the concrete provider(s) to the `AnalyticsProvider` interface.
// The `@IntoSet` annotation is key, as it tells Hilt to add the binding to a
// `Set<AnalyticsProvider>`, which `AnalyticsManager` then consumes.
// -------------------------------------------------------------------------------------

package com.app.ecarepro.analytics.di

// All required imports are already at the top of the file.

@Module
@InstallIn(SingletonComponent::class)
abstract class AnalyticsModule {

    @Binds
    @IntoSet // This is the magic! It adds the binding to a Set<AnalyticsProvider>.
    abstract fun bindFirebaseAnalyticsProvider(
        provider: FirebaseAnalyticsProvider
    ): AnalyticsProvider

    /*
    // FUTURE-PROOFING EXAMPLE: Adding Adobe Analytics would be this simple.
    // 1. Create AdobeAnalyticsProvider.kt implementing AnalyticsProvider.
    // 2. Add the binding below.
    // No other code in the app needs to change.

    @Binds
    @IntoSet
    abstract fun bindAdobeAnalyticsProvider(
        provider: AdobeAnalyticsProvider
    ): AnalyticsProvider
    */
}


